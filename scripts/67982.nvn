show table "Items Output"  d22h23 write: "\{projectFolder}Input/Catalog/Catalog_\{itText}.ion" with
  Catalog.IsTopItem
  Catalog.CategoryDisplayRank
  Catalog.ItemDisplayRank
  Catalog.ItemCode as "Ref" {href: #[Catalog.hRefUrl]}
  Catalog.ItemLoc as "Loc"
  Catalog.Sku as "Sku"
  Catalog.ItemName as "Name"
  Catalog.Category
  Catalog.SubCategory as "SubCategory"
  Catalog.ImageName
  Catalog.Supplier
  Catalog.StartDate
  Catalog.EndDate
  Catalog.Brand as "Brand"
  Catalog.BuyPrice as "BuyPrice"
  Catalog.SellPrice as "SellPrice"
  Catalog.LotMultiplier as "LotMultiplier"
  Catalog.Moq as "Moq"
  Catalog.Volume as "Volume"
  Catalog.InternalStockAggressiveness
  Catalog.IsBimodalDemand
  Catalog.ExtremeBimodalDemandFrequence
  Catalog.ExtremeBimodalDemandFactor
  Catalog.IsRightSkewedDemand
  Catalog.ExtremeRightSkewedDemandFrequence
  Catalog.ExtremeRightSkewedDemandFactor
  order by Catalog.SumByItems desc
