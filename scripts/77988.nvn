
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// --------------------------------------READ INPUT TABLES-----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
import "/1. utilities/Modules/Global Parameters" as GP with
  DcUnit
  LinkLocationItemInspector
  LinkHomeDashboard
  ColorB

const testStorage = ""
const inputPath = "\{testStorage}/Clean/"

read "\{inputPath}Items.ion" as Items[Id unsafe] with
  "Sku" as Id : text
  Name : text
  Category : text
  SellPrice : number
  BuyPrice : number
  StockOnHand : number
  StockOnOrder : number
  LeadTime : number
  ImageUrl : text
  StartDate : date
  EndDate : date
  Supplier : text
  IsClean : boolean
  Q30 : number
  Q90 : number
  Q365 : number
  MOQ : number
  LotMultiplier : number
  ReorderCycle : number

read "/Manual/TopItemsParameters.xlsx" as TopItemsParameters expect[Id] with
  CategoryDisplayRank : number
  Category : text
  ItemDisplayRank : number
  Ref : text
  "Sku" as Id : text

read "\{testStorage}Clean/Orders.ion" as Orders expect [Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  Ref : text
  Loc : text
  Quantity : number
  LokadNetAmount : number
  OrderId : text
  IsFirstOrder : boolean
  HealthLog : text
  IsClean : boolean

read "/Clean/PO.ion" as PO expect[Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  Loc : text
  Ref : text
  DeliveryDate : date
  Quantity : number
  Supplier : text
  PONumber : text
  IsInCatalog : boolean
  IsClean : boolean
  InputDate : date
  InputPath : text

read "/Clean/Stock.ion" as Stock expect[Id, date] with
  "Sku" as Id : text
  StockOnHand : number
  StockOnOrder : number
  "StockDate" as date: date
  IsInCatalog : boolean
  InputDate : date
  InputPath : text

read "\{inputPath}Forecast/Periodic/WeeklyFc.ion" as WeeklyFC expect[Id, date] with
  "Sku" as Id : text
  "Monday" as date: date
  WOODemand : ranvar
  SLTDemand : ranvar
  TotalDemand : ranvar
  IsPast : boolean

///Read for comparison
read "Clean/PurchaseResults/PORecommendations.ion" as PORecommendations expect[Id] with
  Id : text
  Margin : number
  ExpectedROI : number
  BuyPrice : number
  OrderQuantity : number
  InvestmentRequired : number
  CurrentFR : number
  FR : ranvar
  NewFR : number
  LastYearSales : number
  SalesWeight : number
  OverallFRContrib : number
  SupplierLastYearSales : number
  SupplierSalesWeight : number
  SatisfiableDemand : ranvar
  SatisfiedDemand : number
  AvgDemandOnRLT : number
  TotalDemandRLT : ranvar
  TotalDemandRLTDisplay : ranvar

read "Clean/PurchaseResults/DemandDistributions.ion" as DemandDistributions expect[Id] with
  Id : text
  SatisfiableDemand : ranvar
  SatisfiedDemand : number
  AvgDemandOnRLT : number
  TotalDemandRLT : ranvar
  TotalDemandRLTDisplay : ranvar
  HoldingTime : zedfunc

read "Clean/PurchaseResults/MicroDecisions.ion" as Grid expect[Id] with
  Rank : number
  "SKU" as Id : text
  Name : text
  Supplier : text
  BuyPrice : number
  SellPrice : number
  Margin : number
  StockOnHand : number
  StockOnOrder : number
  LotMultiplier : number
  Q : number
  Min : number
  Max : number
  SLT : number
  RLT : number
  SalesWeight : number
  CurrentFR : number
  FillRateDelta : number
  CumFillrateDelta : number
  C : number
  Reward : number
  Score : number
  Investment : number
  CategoryCurrentFR : number
  CumCategoryFRGain : number
  CumOverallFRGain : number
  // IsEligible : boolean

read "/Clean/PurchaseResults/TargetsPurchaseList.ion" as TargetsPORecommendations with
  FRTarget : number
  budgetTarget : number

///Read for validation
read "/Clean/Interface/DeletedSuppliers.ion" as DeletedSuppliers max 5k with
  SupplierIdStr : text
read "/Clean/Interface/InterfaceParameters.ion" as InterfaceParameters with
  exportedAmount : number
read "/Clean/Interface/SuppliersToCheck.ion" as SuppliersToCheck with
  SupplierId : text
  AmountToCheck : number
read "/Clean/Interface/PurchasePerimeter.xlsx" as PurchasePerimeter with
  Buyer : text


read form with
  agressivenessFactorCosmetic : number
  agressivenessFactorMedicalSupplies : number
  agressivenessFactorDrugs : number
  FRTarget : number
  budgetTarget : number
  resetDashboard : boolean
  supplierReintegrate : text
  moveAll : boolean
  exportAll : boolean
  BuyerToMoveOrders : text
  resetParams : boolean

read upload "ExportSuppliers" as ExportSuppliers  with
  Supplier : text
  "Export" as IsToExport : boolean
  "Delete" as IsToDelete : boolean
  "Migrate" as IsToMove : boolean
read upload "PrioritaryValidation" as Validation expect[Id] with
  "Sku" as Id : text
  "Validation ?" as Validated : boolean
  FinalQty : number


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// ------------------------------------------SETUP-------------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
show label "Purchase suggestions" a2f2 {textAlign: center ; textVerticalAlign: center ; textBold: "true"}
show tabs "" a1e1 with
  "Results"
  "Validation" as "Purchase Recommendations Validation"
  "Comparison"
  "Parameters"
  "Hidden" {tabDisplay: "false"}

///Editable body------------------------------------------------------------------------------------

backgroundColorforsummarytile = "#f5f5f5"

show markdown "Overall view" a21f28 {tileTab: "Results"} with  """
### Documentation

__Current Fill Rate__: overall fill rate associated to the current stock on hand and on order, i.e. the proportion of the demand
already covered by the current stock on hand and on order

__Achieved Fill Rate__: overall fill rate associated to the current stock on hand and on order and the recommended purchase suggestions, i.e. the proportion of the demand
which will be covered after purchasing

__Total Investments__: total investment proposed in dollars

__Recommended amount by supplier__: total investment proposed in dollars split by supplier

__All Suppliers Purchase suggestions__: all references to buy and main indicators to understand the purchase recommendations

Sku: reference code

Name: reference name

Category: reference category

Supplier: reference supplier

Leadtime: supplier leadtime in days

Buy price: raw purchase price from the supplier

Sell price: raw sell price

Margin: raw margin, i.e. difference between sell price and buy price

StockOnHand: reference current stock on hand

StockOnOrder: reference current stock on order, i.e. units purchased but not delivered yet

Avg SLT Demand: average forecasted demand on the next supplier leadtime

Avg WOO Demand: average forecasted demand on the next responsibility window (WOO), i.e. a reorder cycle period in a supplier leadtime

Avg Total Demand: average total demand on a supplier leadtime + a responsibility window (or reorder cycle)

Sugg. Order Quantity: recommended purchase quantity to cover the next responsibility window

Investment: investment associated to the recommended purchase quantity

Contrib. to overall Fillrate reference contribution to overall fill rate

__Category x Purchase suggestions__: all references of Category x to buy and main indicators to understand the purchase recommendations. Category x can be choosen in
the filter on the top right corner of the dashboard

__All Suppliers Micro decisions__: all units of every reference to buy prioritized by decreasing order of return on investment

Rank: unit rank of all units of all reference by decreasing order of return on investment (the lower the rank of the unit, the higher its return on investment)

FillRate Δ: additional fill rate brought by the micro decision line purchase, i.e. by a single unit purchase

Exp. Margin: expected gross margin of the given unit

Exp. Stockout Cover: expected stock out penalty covered by the given unit

Exp. Carrying Costs: expected carrying cost of the given unit

Tot. Reward: total reward. Equals to Exp. Margin + Exp. Stockout Cover - Exp. Carrying Costs

ROI: return on investment. Equals to Tot. Reward / Buy price

Cum. Invest.: investment needed to buy the basket

Is Purchased?: for a given reference, all units recommended for purchase are set to "yes", the others to "no"

__Category x Micro decisions__: all units of Category x to buy prioritized by decreasing order of return on investment

__Pareto at Supplier level__: displays current and new fill rate for every supplier ordered by decreasing order of overall turnover proportion. The overall cumulative
turnover proportion is displayed through a black line

__Pareto at Reference level (40 top best-sellers)__: displays current and new fill rate for the first top x references ordered by decreasing order of overall turnover proportion. The overall cumulative
turnover proportion is displayed through a black line

"""


show label "Compare with Min/Max Strategy" a19b19 f5ca91               {href: "https://go.lokad.com/d/68014/" ; labelIcon: "histogram" ; hrefAspect: white ; textAlign: center ; textBold: "true" ; tileTab: "Results"}


oend = max(WeeklyFC.date) when(WeeklyFC.IsPast)


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------------PREPROCESS----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
keep where Items.IsClean

inspectorId = LinkLocationItemInspector
selectedTab = concat("&t=", "Info")
Items.hRefUrlRaw = sliceSearchUrl(inspectorId, Items.Id)
Items.hRefUrl = concat(Items.hRefUrlRaw, selectedTab)
Items.Url = replace(Items.hRefUrl , "~" , "https://go.lokad.com" )

Items.CategoryDisplayRank = same(TopItemsParameters.CategoryDisplayRank)
                            by TopItemsParameters.Category
                            at Items.Category

Items.ItemDisplayRank = same(TopItemsParameters.ItemDisplayRank)

Items.IsTopItem = any(TopItemsParameters.*)

Items.WOODemand = same(WeeklyFC.WOODemand)
Items.SLTDemand = same(WeeklyFC.SLTDemand)
Items.TotalDemand = same(WeeklyFC.TotalDemand)

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------PURCHASE RECOMMENDATIONS--------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Agressiveness factor input
currentTab = "Parameters"

show label "Next" d3                    {href: "https://go.lokad.com/home" ; hrefAspect: white ; textAlign: center ; tileTab: #(currentTab)}
show label "Back" c3                    {hrefAspect: white ; textAlign: center ; tileTab: #(currentTab) ; href: #("https://go.lokad.com/d/68020/")}



show label "https://go.lokad.com/d/68018/ Configure Purchasing Process" a3b3 {labelIcon: "container" ; textAlign: center ; hrefAspect: white ; tileTab: #(currentTab) ; tileColor: #(ColorB)}

table Categories [CategoryName] = by [Items.Category]

show markdown "" c7d8 {tileTab: #(currentTab)} with """
  The `agressiveness factor` allows the user to adjust the agressiveness of the stock coverage per
  category. It ranges from 0 to 5, 5 being the most agressive.
"""

show form "Reset Parameters" e4g5 {formButton: "Run" ; tileTab: #(currentTab)} with
  false as "Reset Parameters?" form:"resetParams"

show markdown "" a7b8 {tileTab: #(currentTab)} with """
  The `Fill Rate` is the fraction of demand that is met through immediate stock availability. This input sets the target that we want to reach
  for this purchase optimization.
"""
show label "To detailed Fill Rate Documentation" a10b10                                 {href: "https://go.lokad.com/d/68036/" ; hrefAspect: white ; textAlign: center ; tileTab: #(currentTab)}



FRTarget = if resetParams then 95 else FRTarget
budgetTarget = if resetParams then 160k else budgetTarget
agressivenessFactorCosmetic = if resetParams then 5 else agressivenessFactorCosmetic
agressivenessFactorMedicalSupplies = if resetParams then 3 else agressivenessFactorMedicalSupplies
agressivenessFactorDrugs = if resetParams then 4 else agressivenessFactorDrugs

show form "Agressiveness factor configuration (0 - 5)" c4d6        {formButton: "Run" ; tileTab: #(currentTab)} with
  agressivenessFactorCosmetic as "Cosmetic" //single(Categories.AgressivenessFactorIni) when(CategoryName == "Cosmetic") as "Cosmetic" form:"agressivenessFactorCosmetic"
  agressivenessFactorMedicalSupplies as "Medical Supplies"  //single(Categories.AgressivenessFactorIni) when(CategoryName == "Medical Supplies") as "Medical Supplies" form:"agressivenessFactorMedicalSupplies"
  agressivenessFactorDrugs as "Drugs" //single(Categories.AgressivenessFactorIni) when(CategoryName == "Drugs") as "Drugs" form:"agressivenessFactorDrugs"

show form "Optimization targets" a4b6 {formButton: "Run" ; fieldColor: #D5ECBC ; tileTab: #(currentTab)}  with
  FRTarget as "Target Fill Rate (0-100%)"
  budgetTarget as "Budget Target ($)"

FRTarget = min(max(FRTarget/100,0),1)

Categories.AgressivenessFactorIni = match Categories.CategoryName with
  "Cosmetic" ->  min(max(agressivenessFactorCosmetic, 0), 5)
  "Medical Supplies" ->  min(max(agressivenessFactorMedicalSupplies, 0), 5)
  "Medical Patient Care" ->  min(max(agressivenessFactorMedicalSupplies, 0), 5)
  "Drugs" ->  min(max(agressivenessFactorDrugs, 0), 5)

Items.AgressivenessFactor = Categories.AgressivenessFactorIni/5 //between 0 and 1

///Economic parameters
//Margin
Items.M = Items.SellPrice - Items.BuyPrice

//OOS penalty
Items.S = - Items.AgressivenessFactor * Items.M

//Carrying cost
carryingCost = 0.2 // % per-period carrying cost relative to purchase price
Items.C = carryingCost * Items.BuyPrice * 7 / 365

Items.ReorderCycleWeeks = ceiling(Items.ReorderCycle / 7)
Items.SupplierLTWeeks = ceiling(Items.LeadTime / 7)
Items.TotalLTWeeks = Items.SupplierLTWeeks + Items.ReorderCycleWeeks

show table "Economic parameters" a28 write:"Clean/PurchaseResults/EconomicParameters.ion" {tileTab: "CategoryView"} with
  Items.Id
  Items.Category

  Items.SellPrice
  Items.BuyPrice

  Items.M
  Items.S
  Items.C
  carryingCost

  Categories.AgressivenessFactorIni
  Items.TotalLTWeeks

write Categories as "Clean/PurchaseResults/EconomicParametersCategories.ion" with
  CategoryName = Categories.CategoryName
  AgressivenessFactor = Categories.AgressivenessFactorIni

write Scalar as "Clean/PurchaseResults/TargetsPurchaseList.ion" with
  FRTarget = Scalar.FRTarget
  budgetTarget  = Scalar.budgetTarget


// Items.CategoryCurrentFR = same(Grid.CategoryCurrentFR)
// Items.CategoryFRTarget = (86 + Items.AgressivenessFactor * 12) / 100

///Distributions
Items.AvgDemandOnRLT = single(DemandDistributions.AvgDemandOnRLT)
Items.SatisfiableDemand = single(DemandDistributions.SatisfiableDemand)
Items.SatisfiedDemand = single(DemandDistributions.SatisfiedDemand)
Items.TotalDemandRLT = single(DemandDistributions.TotalDemandRLT)
Items.TotalDemandRLTDisplay = single(DemandDistributions.TotalDemandRLTDisplay)
Items.HoldingTime = single(DemandDistributions.HoldingTime)

Items.FR = fillrate(Items.TotalDemandRLT)
Items.CurrentFR = int(Items.FR, 0, Items.SatisfiedDemand)

///Score
Items.SellThrough = (1 - cdf(Items.SatisfiableDemand + 1)) * uniform.right(1) //values in negative are not relevant

Items.RwdM = Items.SellThrough * Items.M
Items.RwdS = - Items.SellThrough * Items.S
Items.RwdC = Items.HoldingTime * Items.C

Items.Reward = Items.RwdM + Items.RwdS - Items.RwdC

Grid.M = int(Items.RwdM, Grid.Min, Grid.Max)
Grid.S = int(Items.RwdS, Grid.Min, Grid.Max)
Grid.C = int(Items.RwdC, Grid.Min, Grid.Max)
Grid.Reward = int(Items.Reward, Grid.Min, Grid.Max)

Grid.Cost = Grid.Q * Items.BuyPrice

Grid.Score = Grid.Reward /. Grid.Cost


///Eligible decision
    ///Purchase decision
    //3 categories agressiveness factors = 1-1-1 --> 87% overall fill rate
    //3 categories agressiveness factors = 3-4-5 --> 92% overall fill rate
    //3 categories agressiveness factors = 5-5-5 --> 99% overall fill rate
where date >= oend - 365 and date <= oend
  Items.LastYearSales = sum(Orders.LokadNetAmount)
  lastYearOverallSales = sum(Orders.LokadNetAmount)
  Items.SalesWeight = Items.LastYearSales / lastYearOverallSales
  currentFR = sum(Items.CurrentFR * Items.SalesWeight)
  Items.SupplierLastYearSales = sum(Orders.LokadNetAmount) by Items.Supplier at Items.Supplier

  Items.SupplierSalesWeight = Items.LastYearSales / Items.SupplierLastYearSales

Grid.CumInvest = 0
Grid.IsEligible = false
where Grid.Min > 0
//Ranking potential purchases accoring to the score
  Grid.Rank = rank(Grid.Score, Id, -Grid.Max)

  Grid.CumInvest = sum(Grid.Cost) scan Grid.Rank
  Grid.CumFillrateDelta = sum(Grid.FillRateDelta) by Items.Id scan Grid.Rank

  Grid.OverallFRGain = Grid.FillRateDelta * Items.SalesWeight
  Grid.CumOverallFRGain = sum(Grid.OverallFRGain) scan Grid.Rank

  Grid.IsEligible = FRTarget - currentFR > 0 and
                    Grid.CumOverallFRGain <= FRTarget - currentFR and
                    Grid.CumInvest < budgetTarget
  ///Basile: classic global FRTarget instead of target that is function of agressivity at category level. Asked by Fabian and Swann on 31/01/2024
  // Grid.IsEligible = Items.CategoryFRTarget - Items.CategoryCurrentFR > 0 and
  //                   Grid.CumCategoryFRGain <= Items.CategoryFRTarget - Items.CategoryCurrentFR

  where Grid.IsEligible
    Items.OrderQuantity = sum(Grid.Q)
    Items.ExpectedROI = sum(Grid.Reward) / sum(Grid.Investment)


///Final purchase reporting
Items.FR = same(PORecommendations.FR)
Items.SatisfiedDemand = same(DemandDistributions.SatisfiedDemand)
Items.NewFR = min(int(Items.FR, 0, Items.SatisfiedDemand + Items.OrderQuantity), max(Items.CurrentFR,0.999))

Items.InvestmentRequired = Items.OrderQuantity * Items.BuyPrice

currentTab = "Results"

show summary "" a3d4 {tileTab: #(currentTab) ; backgroundColor: #(backgroundColorforsummarytile)} with ""
show label "Main Financial KPIs" a3d3 {labelBorder: "none" ; textAlign: center ; textBold: "true" ; tileTab: #(currentTab)}

investmentRequired = sum(Items.InvestmentRequired)
show scalar "Total Investments" a4 C72C48  {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  investmentRequired as "" {unit: #(DcUnit)}

salesgenerated = sum(Items.OrderQuantity * Items.SellPrice)
show scalar "Expected Sales" b4 1BCFB4   {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  salesgenerated as "" {unit: #(DcUnit)}

margingenerated = sum(Items.OrderQuantity * (Items.SellPrice-Items.BuyPrice))
show scalar "Expected Margin" c4 11439e {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  margingenerated as "" {unit: #(DcUnit)}

marginrate = margingenerated/salesgenerated
show scalar "Margin Rate" d4 {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  marginrate as "" {numbers: percent}

show summary "" e3f4 {tileTab: #(currentTab) ; backgroundColor: #(backgroundColorforsummarytile)} with ""

show label "FR Evolution" e3f3 {labelBorder: "none" ; textAlign: center ; textBold: "true" ; tileTab: #(currentTab)}
show scalar "Current Fill Rate" e4 343435  {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  currentFR as "" {numbers: percent}

achievedFR = sum(Items.NewFR * Items.SalesWeight)
show scalar "Achieved Fill Rate" f4 08a12e  {textBold: "true" ; textAlign: center ; tileTab: #(currentTab)} with
  achievedFR as "" {numbers: percent}



table Slices [slice] = slice by [-Items.SupplierLastYearSales, Items.Supplier] title: Items.Supplier
Grid.slice = Items.slice

show summary "" a11f13 {tileTab: #(currentTab) ; backgroundColor: #(backgroundColorforsummarytile)} with ""
Items.Rank = rankrev () scan Items.ExpectedROI
where Items.OrderQuantity > 0
  show table "All Suppliers Purchase suggestions" a11f13 {tileTab: "Results"} with
    Items.Id as "Sku" {href: #[Items.Url]}
    // Items.Category as "Category"
    Items.Supplier as "Supplier"
    Items.LeadTime as "Leadtime"
    Items.BuyPrice as "Buy Price" {unit: #(DcUnit)}
    Items.M as "Margin" {unit: #(DcUnit)}
    Items.StockOnHand as "StockOnHand"
    Items.StockOnOrder as "StockOnOrder"
    Items.OrderQuantity as "Sugg. Order Quantity" {unit: " units" ; textBold: "true" ; cellBackground: #d1d1d1}
    Items.ExpectedROI {numbers: percent ; cellBackground: #e1fae8}
    mean(Items.SLTDemand) as "Avg SLT Demand"
    mean(Items.WOODemand) as "Avg WOO Demand"
    mean(Items.TotalDemand) as "Avg Total Demand"

    Items.InvestmentRequired as "Investment" {unit: #(DcUnit)}
    Items.CurrentFR as "Current Fillrate" {numbers: percent}
    Items.NewFR as "Achieved Fillrate" {numbers: percent}
    Items.SalesWeight * Items.NewFR as "Contrib. to overall Fillrate" {numbers: percent}
    Items.Rank
    order by Items.Rank

  show summary "" a9f10 {tileTab: #(currentTab) ; backgroundColor: #(backgroundColorforsummarytile)} with ""
  show barchart "Purchase Amount by Supplier" a9f10  {tileTab: "Results" ; color: #3097ed} with
    sum(Items.InvestmentRequired) {unit: #(DcUnit)}
    group by Items.Supplier
    order by sum(Items.InvestmentRequired) desc

  show label "" a20f20 9b9b9b {tileTab: "Results"}

  show table same("\{Items.Supplier} Purchase suggestions") by slice a16f16 slices:slice {tileTab: "Results"} with
    // "🔎" as "Inspect" {columnReadOnly: "true" ; columnWidth: 2 ; href: #[Items.Url]}
    Items.Id as "Sku" {href: #[Items.Url]}
    Items.Supplier as "Supplier"
    Items.LeadTime as "Leadtime"
    Items.BuyPrice as "Buy Price" {unit: #(DcUnit)}
    Items.StockOnHand as "StockOnHand"
    Items.StockOnOrder as "StockOnOrder"
    Items.OrderQuantity as "Sugg. Order Quantity" {unit: " units" ; cellBackground: #d1d1d1 ; textColor: #C7180F}
    Items.InvestmentRequired as "Investment" {unit: #(DcUnit)}
    Items.CurrentFR as "Current Fillrate" {numbers: percent}
    Items.NewFR as "Achieved Fillrate" {numbers: percent}
    Items.SalesWeight * Items.NewFR as "Contrib. to overall Fillrate" {numbers: percent}
    order by not Items.IsTopItem, Items.CategoryDisplayRank, - Items.InvestmentRequired

Month.PurchasedAmount = sum(PO.Quantity*Items.BuyPrice)
Month.SoldAmount = sum(Orders.LokadNetAmount)
Month.Margin = Month.SoldAmount-Month.PurchasedAmount

where Month.month >= month(oend) - 11 and Month.month <= month(oend) -1
  show linechart "Volumes last 12 months" a5f8 {tileTab: "Results"} with
    Month.PurchasedAmount {color: "C72C48" ; seriesType: bar ; seriesFan: 1}
    Month.SoldAmount {color: "1BCFB4" ; seriesType: bar ; seriesFan: 2}
    Month.Margin  {color: #11439e ; seriesType: bar ; seriesFan: 3}

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------Export list-----------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


write Items as "Clean/PurchaseResults/PORecommendations.ion" with
  Id = Items.Id
  BuyPrice = Items.BuyPrice
  SellPrice = Items.SellPrice
  Margin = Items.M
  ExpectedROI = Items.ExpectedROI
  OrderQuantity = Items.OrderQuantity
  InvestmentRequired = Items.InvestmentRequired
  FR = Items.FR
  CurrentFR = min(Items.CurrentFR,0.999) //as new FR is capped to 99.9% we cap curretn FR as well to stay coherent
  NewFR = Items.NewFR
  LastYearSales = Items.LastYearSales
  SalesWeight = Items.SalesWeight
  OverallFRContrib = Items.SalesWeight * Items.NewFR
  SupplierLastYearSales = Items.SupplierLastYearSales
  SupplierSalesWeight = Items.SupplierSalesWeight
  AvgDemandOnRLT = Items.AvgDemandOnRLT
  SatisfiableDemand = Items.SatisfiableDemand
  SatisfiedDemand = Items.SatisfiedDemand
  TotalDemandRLT = Items.TotalDemandRLT
  TotalDemandRLTDisplay = Items.TotalDemandRLTDisplay
  order by Items.ExpectedROI desc

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///--------------------------------------MICRO DECISIONS------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

Grid.PreviousId = same(Grid.Id) by Grid.Rank at [Grid.Rank - 1]
Grid.IdChangeRank = if Grid.Rank == 1 or Grid.Id != Grid.PreviousId then 1 else 0
Grid.CumIdChangeRank = sum(Grid.IdChangeRank) scan Grid.Rank
Grid.CellColor = if Grid.CumIdChangeRank mod 2 == 0 then "#ffebab" else "#f2f2f2"

///Display
show table "All Suppliers Micro decisions" a18f18 {tileTab: "Results"} with
  // "🔎" as "Inspect" {columnReadOnly: "true" ; columnWidth: 2 ; href: #[Items.Url] ; cellBackground: #[Grid.CellColor]}
  Grid.Rank as "Rank" {cellBackground: #[Grid.CellColor] ; href: #[Items.Url]}
  Items.Id as "Sku" {cellBackground: #[Grid.CellColor]}
  Items.Name as "Name" {cellBackground: #[Grid.CellColor]}
  Items.Supplier as "Supplier" {cellBackground: #[Grid.CellColor]}

  ///Prices
  Grid.BuyPrice as "BuyPrice" {unit: #(DcUnit) ; cellBackground: #[Grid.CellColor]}
  Grid.SellPrice as "SellPrice" {unit: #(DcUnit) ; cellBackground: #[Grid.CellColor]}
  Grid.Margin as "Gross Margin" {unit: #(DcUnit) ; cellBackground: #[Grid.CellColor]}

  ///Stocks
  Grid.StockOnHand as "StockOnHand" {cellBackground: #[Grid.CellColor]}
  Grid.StockOnOrder as "StockOnOrder" {cellBackground: #[Grid.CellColor]}

  ///Grid attributes
  Grid.LotMultiplier as "LotMultiplier" {cellBackground: #[Grid.CellColor]}
  Grid.Q as "Q" {cellBackground: #[Grid.CellColor]}
  Grid.Max as "Basket" {cellBackground: #[Grid.CellColor]}
  Items.LeadTime as "Leadtime" {cellBackground: #[Grid.CellColor]}

  ///Fill rate
  Grid.CurrentFR as "Current Fillrate" {numbers: percent ; cellBackground: #[Grid.CellColor]}
  Grid.FillRateDelta as "FillRate Δ" {numbers: percent ; cellBackground: #[Grid.CellColor]}
  Grid.CurrentFR + Grid.CumFillrateDelta as "Achieved Fillrate" {numbers: percent ; cellBackground: #[Grid.CellColor]}

  ///Reward
  Items.M as "Exp. Margin" {value { minPrecision: 4 } ; cellBackground: #[Grid.CellColor] ; unit: #(DcUnit)}
  Items.S as "Exp. Stockout Cover" {value { minPrecision: 4 } ; cellBackground: #[Grid.CellColor] ; unit: #(DcUnit)}
  Grid.C as "Exp. Carrying Costs" {value { minPrecision: 4 } ; cellBackground: #[Grid.CellColor] ; unit: #(DcUnit)}
  Grid.Reward as "Tot. Reward" {textColor: #C7180F ; value { minPrecision: 4 } ; cellBackground: #[Grid.CellColor] ; unit: #(DcUnit)}
  Grid.Score as "ROI" {textColor: #C7180F ; value { minPrecision: 4 ; precision: 4 } ; cellBackground: #[Grid.CellColor]}

  ///Investment
  // Grid.Investment as "Investment" {unit: #(DcUnit)}
  Grid.CumInvest as "Cum. Invest." {unit: #(DcUnit) ; cellBackground: #[Grid.CellColor]}
  if Grid.IsEligible then "Yes" else "No" as "Is Purchased?" {cellBackground: #[Grid.CellColor]}

  order by Grid.Rank

Grid.SupplierRank = rankrev () by Items.Supplier scan -Grid.Score
Grid.PreviousSliceId = same(Grid.Id) by [Items.Supplier, Grid.SupplierRank] at [Items.Supplier, Grid.SupplierRank - 1]
Grid.SliceIdChangeRank = if Grid.SupplierRank == 1 or Grid.Id != Grid.PreviousSliceId then 1 else 0
Grid.CumSliceIdChangeRank = sum(Grid.SliceIdChangeRank) by Items.Supplier scan Grid.SupplierRank
Grid.SliceCellColor = if Grid.CumSliceIdChangeRank mod 2 == 0 then "#f2f2f2" else "#ffebab"

show table same("\{Items.Supplier} Micro decisions") by slice a17f17 slices:slice {tileTab: "Results"} with
  // "🔎" as "Inspect" {columnReadOnly: "true" ; columnWidth: 2 ; href: #[Items.Url] ; cellBackground: #[Grid.SliceCellColor]}
  Grid.Rank as "Rank" {cellBackground: #[Grid.SliceCellColor] ; href: #[Items.Url]}
  Items.Id as "Sku" {cellBackground: #[Grid.SliceCellColor]}
  Items.Name as "Name" {cellBackground: #[Grid.SliceCellColor]}
  Items.Supplier as "Supplier" {cellBackground: #[Grid.SliceCellColor]}

  ///Prices
  Grid.BuyPrice as "BuyPrice" {unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Grid.SellPrice as "SellPrice" {unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Grid.Margin as "Gross Margin" {unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}

  ///Stocks
  Grid.StockOnHand as "StockOnHand" {cellBackground: #[Grid.SliceCellColor]}
  Grid.StockOnOrder as "StockOnOrder" {cellBackground: #[Grid.SliceCellColor]}

  ///Grid attributes
  Grid.LotMultiplier as "LotMultiplier" {cellBackground: #[Grid.SliceCellColor]}
  Grid.Q as "Q" {cellBackground: #[Grid.SliceCellColor]}
  Grid.Max as "Basket" {cellBackground: #[Grid.SliceCellColor]}
  Items.LeadTime as "Leadtime" {cellBackground: #[Grid.SliceCellColor]}

  ///Fill rate
  Grid.CurrentFR as "Current Fillrate" {numbers: percent ; cellBackground: #[Grid.SliceCellColor]}
  Grid.FillRateDelta as "FillRate Δ" {numbers: percent ; cellBackground: #[Grid.SliceCellColor]}
  Grid.CurrentFR + Grid.CumFillrateDelta as "New Fillrate" {numbers: percent ; cellBackground: #[Grid.SliceCellColor]}

  ///Reward
  Items.M as "Exp. Margin" {value { minPrecision: 4 } ; unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Items.S as "Exp. Stockout Cover" {value { minPrecision: 4 } ; unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Grid.C as "Exp. Carrying Costs" {value { minPrecision: 4 } ; unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Grid.Reward as "Tot. Reward" {textColor: #C7180F ; value { minPrecision: 4 } ; unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  Grid.Score as "ROI" {textColor: #C7180F ; value { minPrecision: 4 ; precision: 4 } ; cellBackground: #[Grid.SliceCellColor]}

  ///Investment
  // Grid.Investment as "Investment" {unit: #(DcUnit)}
  Grid.CumInvest as "Cum. Invest." {unit: #(DcUnit) ; cellBackground: #[Grid.SliceCellColor]}
  if Grid.IsEligible then "Yes" else "No" as "Is Purchased?" {cellBackground: #[Grid.SliceCellColor]}

  order by Grid.Rank

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///----------------------------------------PARETO-------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

lastYearOverallSales = sum(Items.LastYearSales)

Items.CumSupplierLastYearSales = -1
where argwhichever() by Items.Supplier
  Items.CumSupplierLastYearSales = sum(Items.SupplierLastYearSales) scan - Items.SupplierLastYearSales
Items.CumSupplierLastYearSales = same(Items.CumSupplierLastYearSales)
                                 when(Items.CumSupplierLastYearSales != -1)
                                 by Items.Supplier

// show barchart "Pareto at Supplier level" a11f13                        {barchartGroups: bottom ; tileTab: "Results"} with
//   0 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden ; unit: " overall sales"}
//   1 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden}
//   sum(Items.NewFR * Items.SupplierSalesWeight) as "Achieved FR" {numbers: percent ; seriesType: bar ; color: #78baee}
//   sum(Items.CurrentFR * Items.SupplierSalesWeight) as "Current FR" {numbers: percent ; seriesType: bar ; color: #3097ed}
//   group by Items.Supplier
//   order by sum(Items.SalesWeight) desc

// Items.CumLastYearSales = sum(Items.LastYearSales) scan - Items.LastYearSales
// Items.BestSellerRank = rankrev () scan -Items.CumLastYearSales
// bestSellerDisplayNb = 40
// where (Items.BestSellerRank <= bestSellerDisplayNb) into Items
//   show barchart "Pareto at Reference level (\{bestSellerDisplayNb} top best-sellers)" a13f17                  {barchartGroups: bottom ; tileTab: "Results"} with
//     0 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden ; unit: " overall sales"}
//     1 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden}
//     Items.NewFR as "Achieved FR" {numbers: percent ; seriesType: bar ; color: #fdc488}
//     Items.CurrentFR as "Current FR" {numbers: percent ; seriesType: bar ; color: #ec9539}
//     Items.CumLastYearSales / lastYearOverallSales as "% Sales" {numbers: percent ; unit: " overall sales" ; seriesPattern: dotted}
//     group by Id
//     order by Items.CumLastYearSales

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------Investment in function of FR--------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

Grid.NewFR = Grid.CumOverallFRGain + currentFR
Grid.IsFirstLine = Grid.NewFR == min(Grid.NewFR) by 1
Grid.IsRelevantForPlot = (not Grid.IsFirstLine) and Grid.CumOverallFRGain > 0 and Grid.NewFR == min(Grid.NewFR) by floor(1000*Grid.NewFR) //keep 10 values per FR point

table PlotInvestment = with
  [|as FR, as Investment|]
  [|currentFR,0|]
  where Grid.IsRelevantForPlot
    [|Grid.NewFR,Grid.CumInvest|]

show chart "Investment in function of Target Fill Rate" e5g8 ec9539 {numbers: simple ; tileTab: "Comparison" ; haxis { numbers: percent ; unit: "" } ; unit: #(DcUnit)} with
  plotxy PlotInvestment.FR as "Target FR"
    PlotInvestment.Investment as "Investment"
    order by PlotInvestment.FR


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------Comparison with previous simulation-------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

show markdown "" a4g4 {tileTab: "Comparison"} with """
  This tab presents a comparison between the results obtained with the last 2 simulations.
  This allows to see with one look what impact a change of parameters has over the results.
"""
previousColor = "#B6E6F5"
newColor = "#BDF5B6"

previousFRTarget = single(TargetsPORecommendations.FRTarget)
previousBudgetTarget = single(TargetsPORecommendations.budgetTarget)
previousAchievedFR = sum(PORecommendations.SalesWeight * PORecommendations.NewFR)
previousCurrentFR = sum(PORecommendations.SalesWeight * PORecommendations.CurrentFR)
previousInvestmentRequired = sum(PORecommendations.InvestmentRequired)

show scalar "Delta achieved FR" c6 ec9539 {tileTab: "Comparison" ; textBold: "true" ; tileTooltipText: "Delta = New achieved FR - Previous achieved FR"} with achievedFR - previousAchievedFR {numbers: percent}
show scalar "Delta Investment" c5 ec9539 {tileTab: "Comparison" ; textBold: "true" ; tileTooltipText: "Delta = New Investment - Previous Investment"} with round(investmentRequired - previousInvestmentRequired,0) {numbers: simple ; unit: #(DcUnit)}

isFRTargetHighlighted = min(Grid.NewFR) when(not Grid.IsEligible and Grid.Min > 0) > FRTarget
isBudgetTargetHighlighted = min(Grid.CumInvest) when(not Grid.IsEligible and Grid.Min > 0) > budgetTarget

tooltip = "The highlighted KPI is the limiting constraint in this simulation"
show summary "New Targets" a5b5 {tileTab: "Comparison" ; backgroundColor: #(newColor) ; tileTooltipText: #(tooltip)} with
  FRTarget as "FR Target" {numbers: percent ; value { textColor: #(if isFRTargetHighlighted then "ec9539" else "") ; textBold: #(isFRTargetHighlighted) }}
  budgetTarget as "Budget Target" {numbers: simple ; unit: #(DcUnit) ; value { textColor: #(if isBudgetTargetHighlighted then "ec9539" else "") ; textBold: #(isBudgetTargetHighlighted) }}

show summary "Previous Targets" a6b6 {tileTab: "Comparison" ; backgroundColor: #(previousColor)} with
  previousFRTarget as "FR Target" {numbers: percent}
  previousBudgetTarget as "Budget Target" {numbers: simple ; unit: #(DcUnit)}

Items.PreviousOrderQuantity = single(PORecommendations.OrderQuantity)
Items.DeltaOrderQuantity = Items.OrderQuantity - Items.PreviousOrderQuantity

where Items.PreviousOrderQuantity != Items.OrderQuantity
  show table "New vs Previous simulation" a9g11 {tileTab: "Comparison" ; tileTooltipText: "All products whose purchase suggestions have changed compared to the previous simulation"} with
    Items.Id as "Sku" {href: #[Items.Url]}
    Items.DeltaOrderQuantity as "Delta Order Quantity" {columnTooltipText: "Delta = New Order Quantity - Previous Order Quantity" ; cellBackground: #d1d1d1 ; textColor: #C7180F}
    Items.Category as "Category"
    Items.Supplier as "Supplier"
    Items.LeadTime as "Leadtime"
    Items.BuyPrice as "Buy Price" {unit: #(DcUnit)}
    Items.M as "Margin" {unit: #(DcUnit)}
    Items.StockOnHand as "StockOnHand"
    Items.StockOnOrder as "StockOnOrder"
    Items.OrderQuantity as "Sugg. Order Quantity - New" {unit: " units" ; textColor: #C7180F ; cellBackground: #(newColor)}
    Items.InvestmentRequired as "Investment - New" {unit: #(DcUnit) ; cellBackground: #(newColor)}
    Items.CurrentFR as "Current FR - New" {numbers: percent ; cellBackground: #(newColor)}
    Items.NewFR as "Achieved FR - New" {numbers: percent ; cellBackground: #(newColor)}
    Items.SalesWeight * Items.NewFR as "Contrib. to overall FR - New" {numbers: percent ; cellBackground: #(newColor)}
    PORecommendations.OrderQuantity as "Sugg. Order Quantity - Previous" {unit: " units" ; textColor: #C7180F ; cellBackground: #(previousColor)}
    PORecommendations.InvestmentRequired as "Investment - Previous" {unit: #(DcUnit) ; cellBackground: #(previousColor)}
    PORecommendations.CurrentFR as "Current FR - Previous" {numbers: percent ; cellBackground: #(previousColor)}
    PORecommendations.NewFR as "Achieved FR - Previous" {numbers: percent ; cellBackground: #(previousColor)}
    PORecommendations.SalesWeight * PORecommendations.NewFR as "Contrib. to overall FR - Previous" {numbers: percent ; cellBackground: #(previousColor)}
    order by abs(Items.DeltaOrderQuantity) desc

///Validation
currentTab = "Validation"

formButton = "Update"
show form "" e7f7 {backgroundColor: #f2f2fa ; formButton: #(formButton) ; tileTab: #(currentTab)}
show form "" a15c15 {tileTab: #(currentTab)} with
  false as "Reset dashboard [DEMO] ?" form : "resetDashboard"

// Retinitialize booleans for the demo
exportAll = exportAll and not resetDashboard
moveAll = moveAll and not resetDashboard


table Suppliers = by Items.Supplier

Suppliers.Supplier = same(Items.Supplier)
Suppliers.TotalQuantityPurchased = sum(Items.OrderQuantity) by Items.Supplier at Suppliers.Supplier
Suppliers.TotalAmountPurchased = sum(Items.InvestmentRequired) by Items.Supplier at Suppliers.Supplier

Suppliers.IsExportedAndDeleted = same(ExportSuppliers.IsToExport and ExportSuppliers.IsToDelete) by ExportSuppliers.Supplier at Suppliers.Supplier or
                                 same(ExportSuppliers.IsToMove and ExportSuppliers.IsToDelete) by ExportSuppliers.Supplier at Suppliers.Supplier or
                                 same(ExportSuppliers.IsToExport and ExportSuppliers.IsToMove) by ExportSuppliers.Supplier at Suppliers.Supplier

//## Supplier Export
Suppliers.IsAlreadyExported = (not(Suppliers.Supplier in ExportSuppliers.Supplier) and Suppliers.Supplier != supplierReintegrate)
                              and not resetDashboard // Has been exported/deleted in a previous run
Suppliers.IsSupplierToExport = (same(ExportSuppliers.IsToExport)  by ExportSuppliers.Supplier at Suppliers.Supplier or (exportAll and not moveAll and not Suppliers.IsAlreadyExported))
                                and not resetDashboard  and not Suppliers.IsExportedAndDeleted
Suppliers.IsSupplierToDelete = (same(ExportSuppliers.IsToDelete)  by ExportSuppliers.Supplier at Suppliers.Supplier) and not resetDashboard  and not Suppliers.IsExportedAndDeleted
Suppliers.IsSupplierToMove   = (same(ExportSuppliers.IsToMove)  by ExportSuppliers.Supplier at Suppliers.Supplier or (moveAll and not exportAll and not Suppliers.IsAlreadyExported)) and not resetDashboard  and not Suppliers.IsExportedAndDeleted

Suppliers.IsValidationPending = not Suppliers.IsSupplierToExport and not Suppliers.IsSupplierToDelete and not Suppliers.IsSupplierToMove and not Suppliers.IsAlreadyExported

show summary "General KPIs" a4d4 {textAlign: left ; backgroundColor: #(GP.ColorAlight) ; tileTab: #(currentTab)} with
  sum(Suppliers.TotalQuantityPurchased) as "Total Suggested Qty" {textBold: "true" ; unit: #(GP.pcsUnit)}
  sum(Suppliers.TotalQuantityPurchased) when Suppliers.IsValidationPending as "Remaining Qty to Validate" {textBold: "true" ; unit: #(GP.pcsUnit)}
  sum(Suppliers.TotalAmountPurchased) when Suppliers.IsValidationPending as "Remaining Amount" {textBold: "true" ; unit: #(GP.DcUnit)}
  count(Suppliers.IsValidationPending) when (Suppliers.TotalQuantityPurchased > 0) as "# Suppliers to validate" {textBold: "true"}


Items.ChangedQty =single(Validation.FinalQty)
Items.FinalQty = if (Items.ChangedQty > 0 and not resetDashboard) then Items.ChangedQty else Items.OrderQuantity

Items.Validated =  (single(Validation.Validated) or resetDashboard)
Items.IsToExport = Items.Validated and Suppliers.IsSupplierToExport

labelboxdisplay = if any(Items.IsToExport) then "fixed" else "hidden"
show label "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=CB8060E2BF3726438529D2919C33EE3E&path=%2FImages%2Flogos&name=GreenPO.png" d13 {tileTab: #(currentTab) ; tilePlacement: #(labelboxdisplay)}

where Items.IsToExport
  show table "Purchase Orders already validated" a13c13 {backgroundColor: #(GP.blue) ; tileTab: #(currentTab)} with
    Items.Id
    Items.Supplier
    Items.StockOnHand as "StockOnHand"
    Items.StockOnOrder as "StockOnOrder"
    Items.FinalQty
    Items.CurrentFR as "CurrentFR"
    Items.NewFR as "AchievedFR"

///##--------------------------- [ EDITABLE SET-UP ] -------------------------------------
table NewDeletedSuppliers max 500 = with
  [|as SupplierIdStr |]
  where DeletedSuppliers.SupplierIdStr != supplierReintegrate or DeletedSuppliers.SupplierIdStr == ""
    [|DeletedSuppliers.SupplierIdStr|]
  where Suppliers.IsSupplierToDelete
    [|Suppliers.Supplier|]

keep where not (Suppliers.IsSupplierToExport or Suppliers.IsSupplierToDelete or Suppliers.IsSupplierToMove or Suppliers.IsAlreadyExported)

///##------------------------------- [ EXPORT ] -----------------------------------------

Suppliers.CellColor = if Suppliers.IsSupplierToExport then GP.colorSkyBlue else
                      if Suppliers.IsSupplierToMove   then GP.colorSkyBlue else
                      if Suppliers.IsSupplierToDelete then "red" else
                      if Suppliers.IsExportedAndDeleted then "red" else "white"

Suppliers.CellColor = if (Suppliers.IsSupplierToExport and Suppliers.IsSupplierToMove) or
                         (Suppliers.IsSupplierToExport and Suppliers.IsSupplierToDelete) or
                         (Suppliers.IsSupplierToMove and Suppliers.IsSupplierToDelete) then GP.ColorA else Suppliers.CellColor

show table "Suppliers to manage" a5d7 editable: "ExportSuppliers" {tileTab: #(currentTab)} with
  Suppliers.Supplier as "Supplier"
  Suppliers.TotalQuantityPurchased as "Total Quantity" {unit: #(GP.pcsUnit)}
  Suppliers.TotalAmountPurchased as "Total Amount" {unit: #(DcUnit)}
  Suppliers.IsSupplierToExport as "Export" {cellBackground: #[Suppliers.CellColor]}
  Suppliers.IsSupplierToDelete as "Delete" {cellBackground: #[Suppliers.CellColor]}
  Suppliers.IsSupplierToMove   as "Migrate" {cellBackground: #[Suppliers.CellColor]}
  order by Suppliers.TotalAmountPurchased  desc

///## Suppliers Orders Moves
table BuyerList max 100  = by PurchasePerimeter.Buyer
BuyerList.Buyer = same(PurchasePerimeter.Buyer)

show form " " e5f6 {backgroundColor: #f2f2fa ; tileTab: #(currentTab)} with
  "" as "Export to another Buyer" form:"BuyerToMoveOrders" {fieldType: dropdown ; fieldChoices: #(BuyerList.Buyer)}
  "" as "Reintegrate a Supplier" form:"supplierReintegrate" {fieldType: dropdown ; fieldChoices: #(NewDeletedSuppliers.SupplierIdStr)}

show form "Export All Suggestions" e4f4 {backgroundColor: #f2f2fa ; tileTab: #(currentTab)} with
  exportAll as "To Suppliers"

///Détail des suggestions

where Items.OrderQuantity > 0
  show table "All Suppliers Purchase suggestions" a8f12 editable: "PrioritaryValidation" {tileTab: #(currentTab)} with
    Items.Id as "Sku" {href: #[Items.Url]}
    Items.Name as "Name"
    Items.Category as "Category"
    Items.Supplier as "Supplier"
    Items.StockOnHand {unit: #(GP.pcsUnit)}
    Items.StockOnOrder {unit: #(GP.pcsUnit)}
    Items.Q30  {columnTooltipText: "Quantity Sold over last 30 days" ; unit: #(GP.pcsUnit)}
    Items.Q90  {columnTooltipText: "Quantity Sold over last 90 days" ; unit: #(GP.pcsUnit)}
    Items.Q365  {columnTooltipText: "Quantity Sold over last 365 days" ; unit: #(GP.pcsUnit)}
    Items.OrderQuantity as "Sugg. Order Quantity" {unit: " units" ; cellBackground: #d1d1d1 ; textColor: #C7180F}
    Items.FinalQty
    Items.Validated as "Validation ?"
    Items.InvestmentRequired as "Investment" {unit: #(DcUnit)}
    Items.CurrentFR as "Current Fillrate" {numbers: percent}
    Items.NewFR as "Achieved Fillrate" {numbers: percent}
    Items.SellPrice {unit: #(GP.DcUnit)}
    Items.BuyPrice {unit: #(GP.DcUnit)}
    Items.MOQ
    Items.LotMultiplier
    order by not Items.IsTopItem, Items.CategoryDisplayRank, - Items.InvestmentRequired
