show tabs "" a1 {tilePlacement: hidden} with
  "Overall"
  "Planning"
  "Procurement"
  "Dispatch"
  "Pricing"
  "Assort"
  "Asset"
  "Documentation"

dispatchURL = 68016
tabOverall = dashUrl(dispatchURL, "Overall")
tabPlanning = dashUrl(dispatchURL, "Planning")
tabProcurement = dashUrl(dispatchURL, "Procurement")
tabDispatch = dashUrl(dispatchURL, "Dispatch")
tabPricing = dashUrl(dispatchURL, "Pricing")
tabAssort = dashUrl(dispatchURL, "Assort")
tabAsset = dashUrl(dispatchURL, "Asset")
tabDocumentation = dashUrl(dispatchURL, "Documentation")

