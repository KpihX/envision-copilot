    same(Items.ReorderCycle) as "Reorder Cycle" {unit: " d"}
    sum(ItemsWeek.InvestmentRequired) as "Investment" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}
    sum(ItemsWeek.InvestmentRequiredPreviousSim) as "Investment Previous Simulation" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}

  minWeek = min(week) when(ItemsWeek.MedianStockStartWeek > 0)
  where week >= minWeek
    show linechart "Stock evolution (quantity)" d6h8     slices:Items.slice    {tileTab: "ItemView"} with
      1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden}
      same(ItemsWeek.VeryLowStockStartWeek) as "Possible High" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.LowStockStartWeek) as "Certain High" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.MedianStockStartWeek)  as "Median Expected" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.HighStockStartWeek) as "Certain Low" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.VeryHighStockStartWeek) as "Possible Low" {seriesType: area ; color: #ffffff}
      same(ItemsWeek.MedianStockStartWeek) as "OnHand Median" {color: #c62a2a ; seriesLegend: hidden}
      same(ItemsWeek.MedianStockStartWeekPreviousSim) as "OnHand Median - Previous Simulation" {seriesPattern: dotted ; color: #(colorPreviousSim)}
      group by Week.Monday
    show table "ItemsWeek debug" a46  with
      ItemsWeek.Id as "Id"
      ItemsWeek.week as "week"
      ItemsWeek.VeryLowStockStartWeek
      ItemsWeek.LowStockStartWeek
      ItemsWeek.MedianStockStartWeek
      ItemsWeek.HighStockStartWeek
      ItemsWeek.VeryHighStockStartWeek
      ItemsWeek.MedianStockStartWeek
      ItemsWeek.VeryHighStockEndWeek
      ItemsWeek.HighStockEndWeek
      ItemsWeek.MedianStockEndWeek
      ItemsWeek.LowStockEndWeek
      ItemsWeek.VeryLowStockEndWeek
      ItemsWeek.VeryHighDemand
      ItemsWeek.HighDemand
      quantile(ItemsWeek.Demand,0.5) as "MedianDemand"
      ItemsWeek.MedianDemand
      ItemsWeek.LowDemand
      ItemsWeek.VeryLowDemand
      ItemsWeek.Demand
      Week.Monday

  table NewFilteredItemsWeek = where ItemsWeek.OrderQty > 0

  show table "Future Purchases" a47 slices:Items.slice {tileTab: "ItemView"}  with
    NewFilteredItemsWeek.Id as "Sku"
    NewFilteredItemsWeek.Monday as "Purchase Date"
    NewFilteredItemsWeek.Monday + 7*Items.SupplierLTWeeks as "Reception Date"
