      group by Week.Monday

displayRank=displayRank+1
where (Items.PagePosition == displayRank)
  Slices.SelectedItem = same(Id) by Items.PageName at Slices.PageName when (Items.PagePosition == displayRank)
  Slices.SelectedItemName = same(Items.Name) by Items.PageName at Slices.PageName when (Items.PagePosition == displayRank)
  Slices.DisplaySelectedItem = concat(Slices.SelectedItem, " - ", Slices.SelectedItemName)

  show label Slices.DisplaySelectedItem a17h17 9b9b9b              {tileTab: "ItemView"}

  ///Item presentation
  Slices.Url = concat(same(Items.Url)," \{magnifierIcon}")
  show label Slices.Url a20b20                                                    {textAlign: center ; tileTab: "ItemView"}

  Slices.ImageUrl = same(Items.ImageUrl)
  show label Slices.ImageUrl a18b19              {tileTab: "ItemView"}

  show summary "" c18c20 slices:slice                                                    {tileTab: "ItemView" ; tileColor: #(highlightColor)} with
    same(Items.SalesL365) as "L365 d" {numbers: simple ; unit: #(pcsUnit)}
    same(Items.LeadTime) as "Avg LT" {unit: " d"}
    same(Items.ReorderCycle) as "Reorder Cycle" {unit: " d"}
    sum(ItemsWeek.InvestmentRequired) as "Investment" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}
    sum(ItemsWeek.InvestmentRequiredPreviousSim) as "Investment Previous Simulation" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}

  minWeek = min(week) when(ItemsWeek.MedianStockStartWeek > 0)
  where week >= minWeek
    show linechart "Stock evolution (quantity)" d18h20     slices:Items.slice    {tileTab: "ItemView"} with
      1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden}
      same(ItemsWeek.VeryLowStockStartWeek) as "Possible High" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.LowStockStartWeek) as "Certain High" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.MedianStockStartWeek)  as "Median Expected" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.HighStockStartWeek) as "Certain Low" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.VeryHighStockStartWeek) as "Possible Low" {seriesType: area ; color: #ffffff}
      same(ItemsWeek.MedianStockStartWeek) as "OnHand Median" {color: #c62a2a ; seriesLegend: hidden}
      same(ItemsWeek.MedianStockStartWeekPreviousSim) as "OnHand Median - Previous Simulation" {seriesPattern: dotted ; color: #(colorPreviousSim)}
      group by Week.Monday

displayRank=displayRank+1
where (Items.PagePosition == displayRank)
  Slices.SelectedItem = same(Id) by Items.PageName at Slices.PageName when (Items.PagePosition == displayRank)
  Slices.SelectedItemName = same(Items.Name) by Items.PageName at Slices.PageName when (Items.PagePosition == displayRank)
  Slices.DisplaySelectedItem = concat(Slices.SelectedItem, " - ", Slices.SelectedItemName)

  show label Slices.DisplaySelectedItem a21h21 9b9b9b              {tileTab: "ItemView"}

  ///Item presentation
  Slices.Url = concat(same(Items.Url)," \{magnifierIcon}")
  show label Slices.Url a24b24                                                    {textAlign: center ; tileTab: "ItemView"}

  Slices.ImageUrl = same(Items.ImageUrl)
  show label Slices.ImageUrl a22b23              {tileTab: "ItemView"}

  show summary "" c22c24 slices:slice                                                    {tileTab: "ItemView" ; tileColor: #(highlightColor)} with
    same(Items.SalesL365) as "L365 d" {numbers: simple ; unit: #(pcsUnit)}
    same(Items.LeadTime) as "Avg LT" {unit: " d"}
    same(Items.ReorderCycle) as "Reorder Cycle" {unit: " d"}
    sum(ItemsWeek.InvestmentRequired) as "Investment" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}
    sum(ItemsWeek.InvestmentRequiredPreviousSim) as "Investment Previous Simulation" {numbers: simple ; precision: 0 ; unit: #(DcUnit)}

  minWeek = min(week) when(ItemsWeek.MedianStockStartWeek > 0)
  where week >= minWeek
    show linechart "Stock evolution (quantity)" d22h24     slices:Items.slice    {tileTab: "ItemView"} with
      1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden}
      same(ItemsWeek.VeryLowStockStartWeek) as "Possible High" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.LowStockStartWeek) as "Certain High" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.MedianStockStartWeek)  as "Median Expected" {seriesType: area ; color: #fb8f62}
      same(ItemsWeek.HighStockStartWeek) as "Certain Low" {seriesType: area ; color: #fbc367}
      same(ItemsWeek.VeryHighStockStartWeek) as "Possible Low" {seriesType: area ; color: #ffffff}
      same(ItemsWeek.MedianStockStartWeek) as "OnHand Median" {color: #c62a2a ; seriesLegend: hidden}
      same(ItemsWeek.MedianStockStartWeekPreviousSim) as "OnHand Median - Previous Simulation" {seriesPattern: dotted ; color: #(colorPreviousSim)}
      group by Week.Monday

///# Export results
write Categories as "\{exportPath}EconomicParametersCategories.ion" with
  CategoryName = Categories.CategoryName
  AgressivenessFactor = Categories.AgressivenessFactor

write Scalar as "\{exportPath}TargetsPurchaseList.ion" with
  FRTarget = Scalar.FRTarget
  IsContainerSimulation = Scalar.IsContainerSimulation
  nbWeeks = Scalar.nbWeeks
  overallInvestment = Scalar.overallInvestment

write ItemsWeek as "\{exportPath}WeeklyPurchasesByRef.ion" with
  Sku = ItemsWeek.Id
  Monday = ItemsWeek.Monday
  OrderQty = ItemsWeek.OrderQty
  ReceivedQty = ItemsWeek.ReceivedQty
  MedianStockStartWeek = ItemsWeek.MedianStockStartWeek
  MeanStockStartWeek = ItemsWeek.MeanStockStartWeek
  InvestmentRequired = ItemsWeek.InvestmentRequired

a=1
