show scalar "Current StockOnHand" f12 slices: Items.slice {textAlign: center ; tileTab: "CategoryView" ; unit: #(DcUnit)} with sum(Items.StockOnHand * Items.BuyPrice)
// show scalar "Turnover L365 d" c18 slices: Items.Slice {textAlign: right ; tileTab: "CategoryView" ; unit: #(DcUnit)} with sum(Items.TurnoverL365)

show scalar "Total Investments" d6 slices: Items.slice {textAlign: center ; tileTab: "CategoryView"} with
