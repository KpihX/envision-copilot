where date > oend - 60 and (WeeklyFC.IsMajoritySLTCategory or WeeklyFC.IsMajorityWOOCategory or WeeklyFC.IsPast)
  show linechart "Stock evolution (net amount)"  e5h9  slices: Items.slice {tileTab: "CategoryView" ; legend { legendPosition: right }} with
    same(if WeeklyFC.IsMajoritySLTCategory then 1 else 0) as "" {seriesType: background ; color: #f2eeee ; seriesLegend: hidden}
    same(if WeeklyFC.IsMajorityWOOCategory then 1 else 0) as "" {seriesType: background ; color: #ae4141 ; seriesLegend: hidden}
    same(if (WeeklyFC.date <= oend + 7) then 1 else 0) as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden}
    sum(WeeklyFC.StockStartWeekLowBar0*Items.BuyPrice) as "Q\{lowBarQuantile0Display}" {seriesType: area ; areaPosition: below ; color: #F7DAAA ; areaTo: #[sum(WeeklyFC.StockStartWeekLowBar1*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: above ; areaTo: #[sum(WeeklyFC.StockStartWeekLowBar1*Items.BuyPrice)];
    sum(WeeklyFC.StockStartWeekLowBar1*Items.BuyPrice) as "Q\{lowBarQuantile1Display}" {seriesType: area ; areaPosition: below ; color: #fbc367 ; areaTo: #[sum(WeeklyFC.StockStartWeekLowBar2*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: above ; areaTo: #[sum(WeeklyFC.StockStartWeekLowBar2*Items.BuyPrice)];
    sum(WeeklyFC.StockStartWeekLowBar2*Items.BuyPrice) as "Q\{lowBarQuantile2Display}" {seriesType: area ; areaPosition: below ; color: #fb8f62 ; areaTo: #[sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: above ; areaTo: #[sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice)];
    // sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice) as "OnHand Avg" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
    sum(WeeklyFC.StockStartWeekHighBar1*Items.BuyPrice) as "Q\{highBarQuantile1Display}" {seriesType: area ; areaPosition: above ; color: #fb8f62 ; areaTo: #[sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: below ; areaTo: #[sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice)];
    sum(WeeklyFC.StockStartWeekHighBar2*Items.BuyPrice) as "Q\{highBarQuantile2Display}" {seriesType: area ; areaPosition: above ; color: #fbc367 ; areaTo: #[sum(WeeklyFC.StockStartWeekHighBar1*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: below ; areaTo: #[sum(WeeklyFC.StockStartWeekHighBar1*Items.BuyPrice)];
    sum(WeeklyFC.StockStartWeekHighBar3*Items.BuyPrice) as "Q\{highBarQuantile3Display}" {seriesType: area ; areaPosition: above ; color: #F7DAAA ; areaTo: #[sum(WeeklyFC.StockStartWeekHighBar2*Items.BuyPrice)] ; unit: #(DcUnit)} // areaPosition: below ; areaTo: #[sum(WeeklyFC.StockStartWeekHighBar2*Items.BuyPrice)];

    sum(WeeklyFC.AvgStockStartWeek*Items.BuyPrice) as "OnHand Avg" {color: #c62a2a ; unit: #(DcUnit)}
    group by WeeklyFC.date


where date > oend - 50*7
  show linechart "stock health evolution" a11e16 slices: Items.slice {tileTab: "CategoryView"} with
    sum(WeeklyFC.AvgStockStartWeekOver12W*Items.BuyPrice) as "Sold >3M" {seriesType: bar ; seriesStack: bar ; color: #ae4141 ; unit: #(DcUnit)}
    sum(WeeklyFC.AvgStockStartWeek12W*Items.BuyPrice) as "Sold <3M" {seriesType: bar ; seriesStack: bar ; color: #EB694C ; unit: #(DcUnit)}
    sum(WeeklyFC.AvgStockStartWeek8W*Items.BuyPrice) as "Sold <2M" {seriesType: bar ; seriesStack: bar ; color: #fea883 ; unit: #(DcUnit)}
    sum(WeeklyFC.AvgStockStartWeek4W*Items.BuyPrice) + sum(WeeklyFC.AvgStockStartWeek1W*Items.BuyPrice) as "Sold <1M" {seriesType: bar ; seriesStack: bar ; color: #F5CA91 ; unit: #(DcUnit)}
    // sum(WeeklyFC.AvgStockStartWeek1W*Items.BuyPrice) as "Sold <1W" {seriesType: stack ; color: #F9D5A5 ; unit: #(DcUnit)}

    sum(WeeklyFC.StockTestSmooth*Items.BuyPrice)/sum(WeeklyFC.Sales4W*Items.BuyPrice) as "Stock vs 1M Turnover" {color: #d0021b ; unit: "$S/$T"}
    sum(WeeklyFC.StockTestSmoothLY*Items.BuyPrice)/.sum(WeeklyFC.Sales4WLY*Items.BuyPrice) as "Stock vs 1M Turnover LY" {seriesPattern: dotted ; color: #d0021b ; unit: "$S/$T"}
    same(if WeeklyFC.date <= oend then 1 else 0) as "Past" {seriesType: background ; color: #F4F4F4}
    group by WeeklyFC.date

show scalar "Next 6 months COGS" g12 slices: Items.slice {textAlign: center ; tileTab: "CategoryView" ; unit: #(DcUnit)} with sum(WeeklyFC.Sales24W * Items.BuyPrice) when (WeeklyFC.date == oend)
show scalar "Next 6 months Receptions" h12 slices: Items.slice {textAlign: center ; tileTab: "CategoryView" ; unit: #(DcUnit)} with sum(WeeklyFC.FutureReordersQty * Items.BuyPrice)


WeeklyFC.YonYEvolRatio = (sum(WeeklyFC.StockTestSmooth*Items.BuyPrice) by [Items.slice, WeeklyFC.date]/sum(WeeklyFC.Sales4W*Items.BuyPrice) by [Items.slice, WeeklyFC.date]) / (sum(WeeklyFC.StockTestSmoothLY*Items.BuyPrice) by [Items.slice, WeeklyFC.date]/sum(WeeklyFC.Sales4WLY*Items.BuyPrice) by [Items.slice, WeeklyFC.date]) -1
Items.YonYEvolRatioCurrent = avg(WeeklyFC.YonYEvolRatio) when ((date >= oend-3*31) and date <= oend)  by slice
Items.YonYEvolRatioTarget3M = avg(WeeklyFC.YonYEvolRatio) when ((date >= oend+4*7) and date <= oend+15*7) by slice
Items.YonYEvolRatioTarget6M = avg(WeeklyFC.YonYEvolRatio) when ((date >= oend+4*7) and date <= oend+26*7) by slice

show scalar "Stock Evol YonY over last 3 months" f15 slices: Items.slice {tileTab: "CategoryView" ; unit: "%" ; textAlign: center} with same(Items.YonYEvolRatioCurrent)*100
show scalar "Stock Evol YonY projected over next 3 months" g15 slices: Items.slice {tileTab: "CategoryView" ; unit: "%" ; textAlign: center} with same(Items.YonYEvolRatioTarget3M)*100
show scalar "Stock Evol YonY projected over next 6 months" h15 slices: Items.slice {tileTab: "CategoryView" ; unit: "%" ; textAlign: center} with same(Items.YonYEvolRatioTarget6M)*100

// show scalar "Sales Next 6 months" g22 slices: Items.Slice {textAlign: right ; tileTab: "CategoryView" ; color: "eb694c"} with same(Items.cumDemand)































// show markdown "Dashboard" d25                                 {color: #(highlightColor)} with
//   """
//   __This dasboard presents a high-level view of the current projected stock situation__
//   """

// show markdown "Overall view" a18h24                                            {tileTab: "OverallView"} with  """
// ### Documentation

// __Total Investments__: overall total investment proposed to cover next window of responsibility

// __Current Fill Rate on WOO__: overall fill rate associated to the current stock on hand and on order, i.e. the proportion of the demand
// already covered by the current stock on hand and on order on the responsibility window

// __Achieved Fill Rate on WOO__: overall fill rate associated to the current stock on hand and on order and the recommended purchase suggestions, i.e. the proportion of the demand
// which will be covered after purchasing on the responsibility window

// __Categories__:

// To Eco. config.: link to the associated "Economic Parameters" page of the selected category

// Category: category name

// Turnover L365 d: turnover of the category on the last 365 days

// Avg COGs on WOO: average sales valued at buy price on the responsibility window

// Stock End SLT: average estimated stock value at the end of the next supplier leadtime

// Investment required: overall total investment proposed to cover next window of responsibility for the category

// __All agressiveness factors__: chosen agressiveness factors by category.

// `Stock Agressiveness` - Defines the risk associated for not having an item in stock in a range from 1 to 5. 5 means there is a huge penalty to miss a sale.
// 1 means there is a low penalty to miss a sale.

// __Stock evolution (net amount)__: displays overall past stock amount and overall forecasted future average stock amount, as well as a likely and a plausible area

