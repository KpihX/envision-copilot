///Optimization of dispatch from 1 warehouse to multiple locations

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// --------------------------------------READ INPUT TABLES-----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
import "/1. utilities/Modules/Global Parameters" as GP with
  DcUnit
  ColorB
  ColorWarning
  LinkLocationItemInspector
  ConfirmButton

const testStorage = ""
const inputPath = "\{testStorage}/Clean/"

read "\{inputPath}Locations.ion" as Locations[Loc] with
  Loc : text
  CarryingCostWeight : number

// read "/Clean/AutoPartsItems.ion" as Skus[Sku unsafe] expect[Loc] with
//   Sku : text
//   Ref : text
//   Loc : text
//   Name : text
//   "AutoPartsCategoryname" as Category : text
//   SellPrice : number
//   BuyPrice : number
//   RedispatchCycle : number
//   DispatchLT : number
//   StockOnHand : number
//   StockOnOrder : number
//   LeadTime : number
//   ImageUrl : text
//   StartDate : date
//   EndDate : date
//   "AutoPartsSupplier" as Supplier : text
//   LotMultiplierDispatch : number
//   IsClean : boolean
//   Q30 : number
//   Q90 : number

read "/Clean/Items.ion" as Skus[Sku unsafe] expect[Loc] with
  Sku : text
  Ref : text
  Loc : text
  Name : text
  Category : text
  SellPrice : number
  BuyPrice : number
  RedispatchCycle : number
  DispatchLT : number
  StockOnHand : number
  StockOnOrder : number
  LeadTime : number
  ImageUrl : text
  StartDate : date
  EndDate : date
  Supplier : text
  LotMultiplierDispatch : number
  IsClean : boolean
  Q30 : number
  Q90 : number

read "\{testStorage}Clean/Orders.ion" as Orders expect [Sku,Loc, date] with
  Sku : text
  "OrderDate" as date: date
  Ref : text
  Loc : text
  Quantity : number
  LokadNetAmount : number
  OrderId : text
  IsFirstOrder : boolean
  HealthLog : text
  IsClean : boolean

read "/Clean/PO.ion" as PO expect[Sku,Loc, date] with
  Sku : text
  "OrderDate" as date: date
  Loc : text
  Ref : text
  DeliveryDate : date
  Quantity : number
  Supplier : text
  PONumber : text
  IsInCatalog : boolean
  IsClean : boolean
  InputDate : date
  InputPath : text

read "\{inputPath}Forecast/Periodic/WeeklyFc.ion" as WeeklyFC expect[Sku, date] with
  Sku : text
  "Monday" as date: date
  DemandQty : number
  Cache : number
  IsPast : boolean
  FutureWeekRank : number
  Alpha : number
  Dispersion : number
  Baseline : number
  Demand : ranvar
  LowerBarTotal2 : number
  LowerBarTotal1 : number
  HighBarTotal2 : number
  HighBarTotal1 : number
  CumDemand : ranvar

read "/Manual/TopItemsParameters.xlsx" as TopItemsParameters expect[Sku] with
  CategoryDisplayRank : number
  Category : text
  ItemDisplayRank : number
  Ref : text
  Sku : text
read "/Clean/Simulation/SimulationStandard.ion" as SimulationStandard expect[Sku] with
  Sku : text
  "Date" as DispatchDate : date
  Baseline : number
  FutureWeekRank : number
  ROP : number
  DayRank : number
  ForecastWeekAfter : number
  EOQ : number
  StockOnHand : number
  StockEvolOnHand : number
  StockEvolOnOrder : number
  OrderedQty : number
  StockDelivered : number

read form with
  FRTarget : number
  constraints : number
  DCaggressiveness : number
  LONaggressiveness : number
  MANaggressiveness : number
  EDBaggressiveness : number
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// ------------------------------------------SETUP-------------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Colors-------------------------------------------------------------------------------------------

highlightColor =  ColorB
ColorWarning =  ColorWarning
LinkLocationItemInspector =  LinkLocationItemInspector

backgroundColorforsummarytile = "#f5f5f5"

///Global parameters--------------------------------------------------------------------------------

pcsUnit = " Pcs"
oend = max(WeeklyFC.date) when(WeeklyFC.IsPast)

///Global parameters--------------------------------------------------------------------------------
show tabs "" a1f1 with
  "Main"
  "Parameters, Alerts and Documentation"
  "Mid Term Simulation"
  "Export" {tabDisplay: "false"}

///Editable body------------------------------------------------------------------------------------


show label "Dispatch suggestions" a2f2 {textAlign: center ; textVerticalAlign: center ; textBold: "true"}


// show label "https://go.lokad.com/d/66208/ Configuration de l'optimisation de dispatch" f1h1                                                  {labelIcon: "container" ; textAlign: center ; hrefAspect: white ; tileColor: #(highlightColor)}

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------------PREPROCESS----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

Skus.M = Skus.SellPrice - Skus.BuyPrice
Skus.MarginRate = Skus.M/Skus.SellPrice
Skus.RankMarginRate = rankrev()  scan Skus.MarginRate
Skus.RankMarginRatePercent = Skus.RankMarginRate/(count(Skus.*) by Skus.1)
Skus.StockOnHand = if Skus.Loc == "DC" then round(Skus.StockOnHand*1.4) else Skus.StockOnHand


selectedTab = concat("&t=", "Info")
Skus.Url_ItemInspector = sliceSearchUrl(LinkLocationItemInspector,Skus.Sku)

Skus.CategoryDisplayRank = same(TopItemsParameters.CategoryDisplayRank)
                            by TopItemsParameters.Category
                            at Skus.Category

Skus.ItemDisplayRank = same(TopItemsParameters.ItemDisplayRank)
Skus.IsTopItem = any(TopItemsParameters.*)

///Global parameters--------------------------------------------------------------------------------
keep where Skus.IsClean
keep where PO.DeliveryDate > oend + 7

table SkusWeek = cross(Skus, Week)


Week.monday = monday(week)

lastPastWeek = max(WeeklyFC.date) when(WeeklyFC.FutureWeekRank == 0)
WeeklyFC.IsLastPastWeek = WeeklyFC.date == lastPastWeek

lookbackDays = 52 * 7
lookforwardDays = 26 * 7

{formButtonAlign: center ; tileTab: "Parameters, Alerts and Documentation" ; backgroundColor: "lightblue" ; formButton: #(ConfirmButton)}
show form "Target for downstream warehouses" a3b4  with
  FRTarget as "FR Target (%)"

show assert "Target FR should be between 0 and 100" a22b22 {tileTab: "Parameters, Alerts and Documentation" ; tilePlacement: #(if FRTarget >= 0 and FRTarget <= 100 then "hidden" else "fixed")} with
  FRTarget >= 0 and FRTarget <= 100 as "Target FR should be between 0 and 100"

{formButtonAlign: center ; tileTab: "Parameters, Alerts and Documentation" ; formButton: #(ConfirmButton) ; backgroundColor: #(GP.lgreen)}
show form "Stock aggressiveness" e3f5 with
  DCaggressiveness as  "Factor to keep stock in DC"
  LONaggressiveness as "Factor to push stock in LON"
  MANaggressiveness as "Factor to push stock in MAN"
  EDBaggressiveness as "Factor to push stock in EDB"

show label "FR Documentation" f13 f5ca91               {tileTab: "Parameters, Alerts and Documentation" ; href: "https://go.lokad.com/d/68036" ; labelIcon: "manual-list" ; textAlign: center ; hrefAspect: white ; labelBorder: "none" ; textBold: "true" ; iconColor: #d0021b}

///Slices-------------------------------------------------------------------------------------------

Skus.CategoryDisplayRank = rankd(Skus.Category)


Skus.PageName = Skus.Category

table Slices [slice] = slice by [Skus.CategoryDisplayRank, Skus.PageName] title: Skus.PageName

///References attributes----------------------------------------------------------------------------
//LM, MOQ...

///Purchase orders----------------------------------------------------------------------------------

///Arrival
//in real life, probably want to set up a different rule for very late POs
PO.ArrivalTime = max(ceiling((PO.DeliveryDate - lastPastWeek)) / 7, 0)

///Leadtimes----------------------------------------------------------------------------------------


Skus.RedispatchCycleWeeks = ceiling(Skus.RedispatchCycle / 7)

Skus.DispatchLTWeeks = round(Skus.DispatchLT/7) //round and not ceiling because we want to round to 0 weeks here
                                                //assumption : DispatchLT negligible compared to DipatchCycle

Skus.TotalLTWeeks = Skus.DispatchLTWeeks + Skus.RedispatchCycleWeeks

///Agressiveness factor input
//Put a bias into having more stock at the central warehouse as
//we can always send stock later to satellite warehouses but we can't send stock back
Skus.AgressivenessFactor = 0.3
Skus.AgressivenessFactor = match Skus.Loc with
  "DC" -> DCaggressiveness * Skus.AgressivenessFactor
  "LON" -> LONaggressiveness * Skus.AgressivenessFactor
  "MAN" -> MANaggressiveness * Skus.AgressivenessFactor
  "EDB" -> EDBaggressiveness * Skus.AgressivenessFactor


///Economic parameters
//Margin
Skus.M = Skus.SellPrice - Skus.BuyPrice

//OOS penalty
Skus.S = - Skus.AgressivenessFactor * Skus.M

//Carrying cost
Skus.CarryingCost = 0.3 * Locations.CarryingCostWeight // % per-period carrying cost relative to purchase price
                                                        //Loc dependent parameter is there so that users can manually modify the storage cost per Location
Skus.C = Skus.CarryingCost * Skus.BuyPrice * 7 / 365

show table "Economic parameters" a32    write:"Clean/DispatchResults/EconomicParameters.ion"  {tileTab: "Export"} with
  Skus.Sku
  Skus.Loc
  Skus.Category

  Skus.SellPrice
  Skus.BuyPrice

  Skus.M
  Skus.S

  Skus.CarryingCost
  Skus.TotalLTWeeks
  Skus.C

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///----------------------------------------Dispatch LIST--------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//All stock in DC potentially can be dispatched to any of the locations
Skus.StockAvailableForDispatch = single(Skus.StockOnHand) when(Skus.Loc == "DC") by Skus.Ref
//As there is also demand in DC, we wirtually empty DC from all its stock
//and we will reaffect it in the relevant locations (DC being one of the options)
Skus.StockAvailable = if Skus.Loc == "DC" then 0 else Skus.StockOnHand

Skus.Dispersion = same(WeeklyFC.Dispersion)
Skus.Alpha = same(WeeklyFC.Alpha)

trajectoryCount = 500

WeeklyFC.TimeIndex = 0
WeeklyFC.CumDemand = dirac(0)

//in real life you shouldn't use poisson() but a distribution that fits what you can expect from the supplier
//typically computed from the PO history
// Skus.SumBaselineLT = sum(WeeklyFC.Baseline) when(WeeklyFC.Date >= now and WeeklyFC.Date < now + Skus.RedispatchCycleWeeks)

where (not WeeklyFC.IsPast) or WeeklyFC.date == oend //currentWeek defined as past in preprocessing
                                                     //for dispatch we take it into account as we can have a 0 weeks LT
  WeeklyFC.TimeIndex = (rankrev () by WeeklyFC.Sku scan -WeeklyFC.date) - 1 //start rank at 0, needed for 0 weeks LT

  ///Satisfiable demand and Holding time
  Skus.SatisfiableDemand, Skus.HoldingTime = actionrwd.reward(
    TimeIndex: WeeklyFC.TimeIndex,
    Baseline: WeeklyFC.Baseline,
    Dispersion: Skus.Dispersion,
    Alpha: Skus.Alpha,
    StockOnHand: Skus.StockAvailable,
    StockOnOrder : PO.Quantity,
    ArrivalTime : poisson(ceiling(PO.ArrivalTime)), //dirac(0) --> considered as stock on hand, error if < 0
    LeadTime: poisson(Skus.DispatchLTWeeks),
    StepOfReorder: Skus.RedispatchCycleWeeks,
    Samples: trajectoryCount,
    Seed: 1)

  //Rwd
  Skus.StockLeftEndDispatchLT = max(0, -Skus.SatisfiableDemand)

  //Fillrate
  // Skus.MeanPriorDemand = mean(Skus.DemandOLT)
  Skus.MeanPriorDemand = sum(WeeklyFC.Baseline)
                        when (WeeklyFC.TimeIndex >= Skus.DispatchLTWeeks and
                        WeeklyFC.TimeIndex < Skus.DispatchLTWeeks + Skus.RedispatchCycleWeeks)

  Skus.SatisfiedDemand = round(max(0, Skus.MeanPriorDemand - mean(Skus.SatisfiableDemand))) //Demand satisfied by the available stock by the end of t + SLT. Just for
  Skus.TotalDemand = Skus.SatisfiableDemand + Skus.SatisfiedDemand // All these offset
  // Skus.FillRateTotalDemand = fillrate(Skus.TotalDemand)

  WeeklyFC.CumDemand = actionrwd.demand(
    TimeIndex: WeeklyFC.TimeIndex,
    BaseLine: WeeklyFC.Baseline,
    Dispersion: Skus.Dispersion,
    Alpha: Skus.Alpha)

  WeeklyFC.PreviousCumDemand = same(WeeklyFC.CumDemand)
                                when(WeeklyFC.TimeIndex != 0)
                                by [WeeklyFC.Sku, WeeklyFC.TimeIndex]
                                at [WeeklyFC.Sku, WeeklyFC.TimeIndex - 1]

  ///Satisfied demand
  Skus.AvgDemandOnRLT = sum(WeeklyFC.Baseline)
                          when(WeeklyFC.TimeIndex >= Skus.DispatchLTWeeks and WeeklyFC.TimeIndex < Skus.TotalLTWeeks)
  Skus.SatisfiedDemand = max(round(Skus.AvgDemandOnRLT - mean(Skus.SatisfiableDemand)),0) //is this max relevant ?

  ///New all RLT demand rebuilt
  Skus.TotalDemandRLT = Skus.SatisfiableDemand + dirac(Skus.SatisfiedDemand)

  ///Sell through
  //SellThrough: probability to sell a specific unit of the satisfiable demand on responsibility window
  //Ex: probability of selling the 6th unit = probability of selling exactly 6 units + probability of selling exactly 7 units +
  // ... probability of selling the maximum of the satisfiable demand
  Skus.SellThrough = (1 - cdf(Skus.SatisfiableDemand + 1)) * uniform.right(1) //values in negative are not relevant

///Dispatch list------------------------------------------------------------------------------------

  ///Grid
  //Action reward considers the additional units to purchase so the Grid has to start at 1

  Skus.Reach = if Skus.Loc != "DC" then max(quantile (Skus.SatisfiableDemand, 1),0) +  max(Skus.LotMultiplierDispatch-1,0) else
                  max(max(quantile (Skus.SatisfiableDemand, 1),0) +  max(Skus.LotMultiplierDispatch-1,0),Skus.StockAvailableForDispatch)
  table Grid = extend.ranvar(Skus.SatisfiableDemand, 0, Skus.LotMultiplierDispatch, Skus.Reach)

  //For DC we want to make sure we can reaffect all the stock back to DC even if the demand is much lower (over stock) hence the different reach

  Grid.Ref = Skus.Ref
  ///Qty
  Grid.Q = Grid.Max - Grid.Min + 1



  ///Fill rate
  Skus.FR = fillrate(Skus.TotalDemandRLT)
  Skus.CurrentFR = min(int(Skus.FR, 0, Skus.SatisfiedDemand),0.999)
  Skus.CurrentFRForDisplay = if Skus.Loc == "DC" then min(int(Skus.FR, 0, Skus.SatisfiedDemand+Skus.StockOnHand),0.999) else Skus.CurrentFR



  ///Fabian wants Sell Probability, for reporting purposes
  //Subtility: what if there is a group (lot multiplier)? We display the proba of selling first and last unit
  Grid.SellProbabilityMin = round(100*max(0,valueAt(Skus.SellThrough,Grid.Min)),1) ///max for rounding mistakes, we could have -1.10e-7 which then is displayed as -0.00 which doesn't look good for probability
  Grid.SellProbabilityMax = round(100*max(0,valueAt(Skus.SellThrough,Grid.Max)),1) ///max for rounding mistakes, we could have -1.10e-7 which then is displayed as -0.00 which doesn't look good for probability

  Grid.SellProbability = if Grid.Min != Grid.Max then concat(Grid.SellProbabilityMin, "% - ", Grid.SellProbabilityMax, "%") else concat(Grid.SellProbabilityMax,"%")


  ///Target
  locFRTarget = FRTarget / 100

  where date >= oend - 365 and date <= oend
    Skus.LastYearSales = sum(Orders.LokadNetAmount)
    lastYearOverallSales = sum(Orders.LokadNetAmount)
    lastYearSalesEDB = sum(Orders.LokadNetAmount) when(Orders.Loc == "EDB")
    lastYearSalesLON = sum(Orders.LokadNetAmount) when(Orders.Loc == "LON")
    lastYearSalesMAN = sum(Orders.LokadNetAmount) when(Orders.Loc == "MAN")
    lastYearSalesDC = sum(Orders.LokadNetAmount) when(Orders.Loc == "DC")

    Skus.SalesWeight = Skus.LastYearSales / lastYearOverallSales
    Skus.SalesWeightEDB = sum(Orders.LokadNetAmount) when(Orders.Loc == "EDB") / lastYearSalesEDB
    Skus.SalesWeightLON = sum(Orders.LokadNetAmount) when(Orders.Loc == "LON") / lastYearSalesLON
    Skus.SalesWeightMAN = sum(Orders.LokadNetAmount) when(Orders.Loc == "MAN") / lastYearSalesMAN
    Skus.SalesWeightDC = sum(Orders.LokadNetAmount) when(Orders.Loc == "DC") / lastYearSalesDC

    overallCurrentFR = sum(Skus.CurrentFR * Skus.SalesWeight)
    EDBCurrentFR = sum(Skus.CurrentFR * Skus.SalesWeightEDB)
    LONCurrentFR = sum(Skus.CurrentFR * Skus.SalesWeightLON)
    MANCurrentFR = sum(Skus.CurrentFR * Skus.SalesWeightMAN)
    DCCurrentFR = sum(Skus.CurrentFR * Skus.SalesWeightDC)

    Skus.CategoryLastYearSales = sum(Orders.LokadNetAmount) by Skus.Category at Skus.Category
    Skus.CategorySalesWeight = Skus.LastYearSales / Skus.CategoryLastYearSales
    Skus.CategoryCurrentFR = sum(Skus.CurrentFR * Skus.CategorySalesWeight) by Skus.Category

    Skus.SupplierLastYearSales = sum(Orders.LokadNetAmount) by Skus.Supplier at Skus.Supplier
    Skus.SupplierSalesWeight = Skus.LastYearSales / Skus.SupplierLastYearSales

  Skus.CurrentFR_AtLocation =  match Skus.Loc with
    "DC" ->  sum(Skus.CurrentFRForDisplay * Skus.SalesWeightDC) by Skus.1
    "EDB" -> sum(Skus.CurrentFRForDisplay * Skus.SalesWeightEDB) by Skus.1
    "MAN" -> sum(Skus.CurrentFRForDisplay * Skus.SalesWeightMAN) by Skus.1
    "LON" -> sum(Skus.CurrentFRForDisplay * Skus.SalesWeightLON) by Skus.1


  Grid.FillRateDelta = int(Skus.FR, Skus.SatisfiedDemand + Grid.Min, Skus.SatisfiedDemand + Grid.Max)
  Grid.OverallFRGain = Grid.FillRateDelta * Skus.SalesWeight
  ///Score

  Grid.Reward = Grid.OverallFRGain * Skus.AgressivenessFactor
  Grid.HoldingTime = int(Skus.HoldingTime, Grid.Min, Grid.Max)


  //Same rule as solve.moq for score of a negative reward
  Grid.Score =  Grid.Reward

  ///Micro decisions build
  //removing unecessary scenario ([0,0] segment created by default in the grid)
  Grid.IsEnoughStockRemaining = true //init
  where Grid.Min > 0
  //Ranking potential dispatches accoring to the score
    Grid.Rank = rank(Grid.Score, Sku, -Grid.Max)
    Grid.OverallFRGain = Grid.FillRateDelta * Skus.SalesWeight
    loop 3 //we use cum FR to determine what is eligible but what is eligible has an impact on the cum FR. looping 3 times should be enough to reach stable point.
      ///Handle case when FR is already reached so decision shouldn't count in CumStockDispatchedByRef as it won't be taken
      //easy to understand edge case when set a FR target of 0%
      Grid.CumFRGainEDB = sum(if Grid.IsEnoughStockRemaining and Grid.Loc == "EDB" then Grid.FillRateDelta * Skus.SalesWeightEDB else 0) scan Grid.Rank
      Grid.CumFRGainLON = sum(if Grid.IsEnoughStockRemaining and Grid.Loc == "LON" then Grid.FillRateDelta * Skus.SalesWeightLON else 0) scan Grid.Rank
      Grid.CumFRGainMAN = sum(if Grid.IsEnoughStockRemaining and Grid.Loc == "MAN" then Grid.FillRateDelta * Skus.SalesWeightMAN else 0) scan Grid.Rank
      Grid.CumFRGainDC = sum(if Grid.IsEnoughStockRemaining and Grid.Loc == "DC" then Grid.FillRateDelta * Skus.SalesWeightDC else 0) scan Grid.Rank

      Grid.CumOverallFRGain = sum(if Grid.IsEnoughStockRemaining then Grid.OverallFRGain else 0) scan Grid.Rank //just for debugging micr decisions
      Grid.CumFillRateDelta = sum(if Grid.IsEnoughStockRemaining then Grid.FillRateDelta else 0) by Sku scan Grid.Rank //just for debugging micro decisions

      Grid.IsBelowTargetEDB = Grid.CumFRGainEDB <= (locFRTarget - EDBCurrentFR) or Grid.Loc != "EDB"
      Grid.IsBelowTargetLON = Grid.CumFRGainLON <= (locFRTarget - LONCurrentFR) or Grid.Loc != "LON"
      Grid.IsBelowTargetMAN = Grid.CumFRGainMAN <= (locFRTarget - MANCurrentFR) or Grid.Loc != "MAN"

      Grid.CumStockDispatchedByRef = sum(if Grid.IsBelowTargetEDB and Grid.IsBelowTargetLON and Grid.IsBelowTargetMAN then Grid.Q else 0)
                                        scan Grid.Rank by [Grid.Ref]

      Grid.IsEnoughStockRemaining = Skus.StockAvailableForDispatch >= Grid.CumStockDispatchedByRef and Skus.StockAvailableForDispatch > 0


      ///Eligible decisions
      Grid.IsEligible = Grid.IsEnoughStockRemaining and
                        (Grid.CumFRGainEDB <= (locFRTarget - EDBCurrentFR) or Grid.Loc != "EDB") and
                        (Grid.CumFRGainLON <= (locFRTarget - LONCurrentFR) or Grid.Loc != "LON") and
                        (Grid.CumFRGainMAN <= (locFRTarget - MANCurrentFR) or Grid.Loc != "MAN") and
                        (Grid.CumFRGainDC <= (1 - DCCurrentFR) or Grid.Loc != "DC") //should always be true (can't go above 100%). Could be removed but left
                                                                                    //here so that it is explicit that we should allow 100% FR in upstream warehouse

    where Grid.IsEligible
      Skus.DispatchQuantity = sum(Grid.Q) //qty that arrives in store
      Skus.DispatchQuantityWarehouse = sum(Grid.Q) when(Grid.Loc != "DC") by [Grid.Ref] at [Skus.Ref] //qty that leaves from entrepot


 //Writing full prioritized list
    // where Grid.IsEnoughStockRemaining //discussion with Fabian : only wants to display all possible decisions
    show table "Grid"  write: "Clean/DispatchResults/MicroDecisions.ion"  {tileTab: "Export"} with
      Grid.Rank as "Rank"
      Skus.LastYearSales
      Skus.SalesWeight * 100
      Grid.Loc as "Loc"
      Grid.Ref as "Ref"
      Sku as "Sku"
      Skus.Category
      Skus.BuyPrice
      Skus.SellPrice
      Skus.M as "Margin"
      Skus.StockOnHand
      Skus.StockAvailableForDispatch
      Grid.Q
      Grid.Min
      Grid.Max
      Skus.DispatchLTWeeks as "Transportation LT" {unit: " week(s)"}
      Skus.RedispatchCycleWeeks as "Redispacth LT" {unit: " week(s)"}
      Skus.CurrentFR {numbers: percent}
      Grid.FillRateDelta {numbers: percent}
      Grid.CumFillRateDelta {numbers: percent}
      Grid.OverallFRGain {numbers: percent}
      Grid.CumOverallFRGain {numbers: percent}
      Grid.CumStockDispatchedByRef
      Grid.CumFRGainEDB + EDBCurrentFR as "NewFR EDB" {numbers: percent}
      Grid.CumFRGainLON + LONCurrentFR as "NewFR LON" {numbers: percent}
      Grid.CumFRGainMAN + MANCurrentFR as "NewFR MAN" {numbers: percent}
      Grid.IsBelowTargetEDB
      Grid.IsBelowTargetLON
      Grid.IsBelowTargetMAN
      (Grid.CumFRGainDC <= (1 - DCCurrentFR) or Grid.Loc != "DC")
      locFRTarget as "FR target by location" {numbers: percent}


      Grid.Reward as "Reward" {numbers: simple ; minPrecision: 8}
      Grid.Score  as "Score" {numbers: simple ; minPrecision: 8}

      Grid.IsEnoughStockRemaining
      Grid.IsEligible

      order by Grid.Rank

 //Displaying full simplified prioritized list
    // where Grid.IsEnoughStockRemaining //discussion with Fabian : only wants to display all possible decisions
    description = "All possible decisions (unit by unit) weighted in the optimisation."
    where Grid.IsEnoughStockRemaining
      Grid.Rank = rank(Grid.Score, Sku, -Grid.Max)///We rank again just to display something where a prospect is not surprised
      description = "All possible decisions (unit by unit) weighted in the optimisation."
      show summary "" a9f11 {tileTab: "Parameters, Alerts and Documentation" ; backgroundColor: #(backgroundColorforsummarytile)} with ""
      show table "All micro decisions" a9f11  {tileTab: "Parameters, Alerts and Documentation" ; tileTooltipText: #(description)} with
        Grid.Rank as "Rank"
        Loc as "Destination Loc"
        Grid.Ref as "Ref"
        // Sku as "Sku"
        // Skus.Category
        // Skus.BuyPrice
        // Skus.SellPrice
        Skus.M as "Margin"
        Skus.StockOnHand
        Skus.StockAvailableForDispatch as "Stock DC before Dispatch"
        Skus.LastYearSales
        Grid.Q as "Quantity"
        // Grid.Min
        Grid.Max as "Units dispatched"
        Grid.SellProbability as "Sell Probability" {numbers: percent ; columnTooltipText: "In case of lots, we display: 'proba of selling 1st unit - proba of selling last unit'"}
        // Skus.DispatchLTWeeks as "Transportation LT" {unit: " week(s)"}
        Skus.RedispatchCycleWeeks as "Redispatch LT" {unit: " week(s)"}
        // Skus.CurrentFR {numbers: percent}
        // Grid.FillRateDelta {numbers: percent}
        // Grid.CumFillRateDelta {numbers: percent}
        // Grid.OverallFRGain {numbers: percent}
        // Grid.CumOverallFRGain {numbers: percent}
        // Grid.CumStockDispatchedByRef
        Grid.CumFRGainEDB + EDBCurrentFR as "NewFR EDB" {numbers: percent}
        Grid.CumFRGainLON + LONCurrentFR as "NewFR LON" {numbers: percent}
        Grid.CumFRGainMAN + MANCurrentFR as "NewFR MAN" {numbers: percent}
        // Grid.IsBelowTargetEDB
        // Grid.IsBelowTargetLON
        // Grid.IsBelowTargetMAN
        // locFRTarget as "FR target by location" {numbers: percent}
        Grid.FillRateDelta {numbers: percent}
        Skus.SalesWeight  as "SalesWeight" {numbers: percent ; minPrecision: 4}
        Grid.Reward *100 as "Reward" {numbers: simple ; minPrecision: 5}
        // Grid.IsEligible

        order by Grid.Rank

  ///Final purchase reporting
  Skus.NewStockWarehouse = Skus.StockAvailableForDispatch - Skus.DispatchQuantityWarehouse
  Skus.NewFR = min(int(Skus.FR, 0, Skus.SatisfiedDemand + Skus.DispatchQuantity), 0.999)



///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------DISPATCH RECOMMENDATIONS--------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

show table "Dispatch recommendations" write : "Clean/DispatchResults/DispatchRecommendations.ion"  {tileTab: "Export"} with
  Skus.Sku
  Skus.Ref
  Skus.Loc
  Skus.M
  Skus.StockOnHand
  sum(PO.Quantity) into Skus as "StockOnOrder"
  Skus.DispatchQuantity as "Qty to Dispatch"
  Skus.StockOnHand + Skus.DispatchQuantity as "StockOnHand after Dispatch" //approximation : only valid because we assume it takes 0 week for the stock to arrive
  Skus.FR {numbers: percent}
  Skus.CurrentFRForDisplay as "CurrentFR" {numbers: percent}
  Skus.NewFR {numbers: percent}
  Skus.LastYearSales
  Skus.SalesWeight {numbers: percent}
  Skus.SalesWeight * Skus.NewFR as "OverallFRContrib" {numbers: percent}
  Skus.AvgDemandOnRLT
  Skus.SatisfiableDemand
  Skus.SatisfiedDemand
  Skus.TotalDemandRLT
  Skus.StockAvailableForDispatch
  Skus.DispatchQuantityWarehouse
  Skus.NewStockWarehouse
  order by Sku

show summary "" a3c5 {tileTab: "Main" ; backgroundColor: #(backgroundColorforsummarytile)} with ""
show label "FR Evolution"  a3c3 {tileTab: "Main" ; labelBorder: "none" ; textAlign: center ; textBold: "true"}
show gauge "Current FR" a4a5     {tileTab: "Main" ; textAlign: center ; precision: 1 ; gaugeFillColor: #89c8f0} with
  sum(Skus.CurrentFRForDisplay * Skus.SalesWeight) as "" {numbers: percent}

// show label "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=5548517A9555509655CCF373F131C353&path=%2FImages%2FNewHomePage&name=test5.png" b5b6 {tileTab: "Main"}
// show scalar "" b5c6 with"⟹" // "➡"

show gauge "New FR" c4c5     {tileTab: "Main" ; textAlign: center ; precision: 1 ; gaugeFillColor: #7fc779} with
  sum(Skus.NewFR * Skus.SalesWeight) as "" {numbers: percent}

// description = "Overall FR gain after applying the dispatch suggestions"



Skus.NewFRatLocation = match Skus.Loc with
  "DC" -> sum(Skus.NewFR * Skus.SalesWeightDC) by Skus.1
  "EDB" -> sum(Skus.NewFR * Skus.SalesWeightEDB) by Skus.1
  "MAN" -> sum(Skus.NewFR * Skus.SalesWeightMAN) by Skus.1
  "LON" -> sum(Skus.NewFR * Skus.SalesWeightLON) by Skus.1

Skus.OrderLoc = match Skus.Loc with
  "DC" -> 1
  "EDB" -> 3
  "MAN" -> 4
  "LON" -> 2

where Skus.Loc != "DC"
  show chart "FR Evolution by Location" a6c8 { tileTab: "Main" ; vaxis { axisMax: "1" }} with
    haxis by Skus.Loc
      order by [same(Skus.OrderLoc)]
    plot by Skus.Loc
      same(Skus.NewFRatLocation) as "New Fillrate" {numbers: percent ; seriesType: bar ; color: #7fc779  ; seriesLegendRank: "2"}
      same(Skus.CurrentFR_AtLocation) as "Current Fillrate" {numbers: percent ; seriesType: bar ; color: #89c8f0  ; seriesLegendRank: "1"}


show summary "" a12f13 {tileTab: "Main" ; backgroundColor: #(backgroundColorforsummarytile)} with ""
where Skus.DispatchQuantity > 0 and Skus.Loc != "DC" //dispatch to DC considered in the logic to be able to properly reaffect stock
                                                     //this is factice, no stock is going to move from DC to DC so don't display it in
                                                     //the summary of the results for the client
  show table "Dispatch suggestions" a12f13 {tileTab: "Main"} with
    Skus.Sku as "Sku"  {columnTooltipText: "Reference x location code" ; href: #[Skus.Url_ItemInspector]}
    Skus.Loc {columnTooltipText: "Location code"}
    Skus.DispatchQuantity as "Dispatch Qty" {textBold: "true" ; cellBackground: #d1d1d1 ; columnTooltipText: "Recommended dispatch quantity to cover the next responsibility window" ; unit: #(pcsUnit)}
    Skus.CurrentFRForDisplay as "Current FR" {numbers: percent ; columnTooltipText: "Fill rate associated to the current stock, i.e. the proportion of the demand already covered by the current stock "}
    Skus.NewFR as "New FR" {numbers: percent ; cellBackground: #e1fae8 ; columnTooltipText: "Fill rate associated to the current stock + recommended dispatch suggestion, i.e. the proportion of the demand which will be covered after dispatching"}
    Skus.LotMultiplierDispatch as "LotMultiplier" {columnTooltipText: ": Numbers of units by which we can dispatch the Sku (for one ref, can change depending on the location)" ; unit: #(pcsUnit) ; textBold: #[if Skus.LotMultiplierDispatch > 1 then true else false]}
    Skus.TotalLTWeeks as "Lead Time" {unit: " week(s)" ; columnTooltipText: "Duration of the next leadtime (transportation time + redispatch cycle)"}
    Skus.StockOnHand as "Stock On Hand" {columnTooltipText: "Stock on hand before dispatch in the location" ; unit: #(pcsUnit)}
    Skus.StockOnOrder as "Stock On Order" {columnTooltipText: "Stock in delivery to the location. For example:stock in transit from warehouse to a store " ; unit: #(pcsUnit)}
    round(mean(Skus.TotalDemand)) as "Demand" {columnTooltipText: "Avg demand next Leadtime" ; unit: #(pcsUnit)}
    Skus.Q30 {columnTooltipText: "Sales Last 30 Days"}
    Skus.Q90 {columnTooltipText: "Sales Last 90 Days"}
    order by - Skus.DispatchQuantityWarehouse

  // Skus.ValueByCategoryColor = match Skus.Category with
  //   "Car Mats" ->  "#89c8f0"
  //   "Winter Accessories" ->  "#89c8f0"
  //   "Wheel & tyre accessories" ->  "#89c8f0"
  //   "Charging Accessories" -> "#89c8f0"
  //   "Brakes" -> "#89c8f0"

  Skus.ValueByCategoryColor = match Skus.Category with
    "Medical Supplies" ->  "#89c8f0"
    "Medical Patient Care" ->  "#89c8f0"
    "Cosmetic" ->  "#89c8f0"
    "Drugs" -> "#89c8f0"

  show barchart "Dispatch value by Category" d6f8  {tileTab: "Main"} with
    sum(Skus.DispatchQuantity * Skus.SellPrice) {unit: #(DcUnit) ; color: #[same(Skus.ValueByCategoryColor)]}
    group by Skus.Category
    order by sum(Skus.DispatchQuantity) desc

// Skus.NewFRatLocationColor = match Skus.Loc with
//   "MAN" -> "#948569"
//   "EDB" -> "#ba9e6a"
//   "LON" -> "#eba526"
//   "DC" -> "#fad38c"

show summary "" d3f5 {tileTab: "Main" ; backgroundColor: #(backgroundColorforsummarytile)} with ""
show label "Main KPIs" d3f3 {tileTab: "Main" ; labelBorder: "none" ; textAlign: center ; textBold: "true"}
show scalar "FR gain" d5 7fc779     {tileTab: "Main" ; textBold: "true" ; textAlign: center} with
  sum(Skus.NewFR * Skus.SalesWeight) - sum(Skus.CurrentFRForDisplay * Skus.SalesWeight) as "" {numbers: percent ; plusSign: nonzero}

totalValueDispatched = round(sum(Skus.DispatchQuantity*Skus.SellPrice) when (Skus.Loc != "DC"))

show scalar "Total Value Dispatched" f5 {tileTab: "Main" ; textAlign: center ; textBold: "true" ; unit: "$";numbers:simple} with totalValueDispatched as ""

totalQtyDispatched = sum(Skus.DispatchQuantity) when (Skus.Loc != "DC")
show scalar "Total Quantity" d4 {tileTab: "Main" ; textAlign: center ; textBold: "true"} with totalQtyDispatched as ""
show scalar "Capacity" e4 {tileTab: "Main" ; textBold: "true" ; textAlign: center} with constraints
pickingWorkload = totalQtyDispatched/constraints
pickingWorkloadColor = if pickingWorkload <= 1 then "7fc779" else "#9c2727"
show scalar "Picking Workload" f4 {tileTab: "Main" ; textAlign: center ; textBold: "true" ; numbers: percent ; tileColor: #(pickingWorkloadColor)} with pickingWorkload

///Linechart with previous Dispatched Qty and FR over last 30 days

startingCurrentFR = sum(Skus.CurrentFRForDisplay * Skus.SalesWeight)
startingNewFR = sum(Skus.NewFR * Skus.SalesWeight)
where date >= oend - 30 and date <= oend
  Day.RandomCurrentFR = if date == oend then startingCurrentFR else 0.8 +0.1* random.uniform(Day.0,Day.1)
  Day.RandomNewFR = if date == oend then startingNewFR else  max(0.82 +0.1* random.uniform(Day.0,Day.1),Day.RandomCurrentFR +0.05* random.uniform(Day.0,Day.1))
  {tileTab: "Main" ; vaxis { left { axisMin: "75" ; axisMax: "97" ; axisMin: "75" } }}
  // { vaxis { right { axisMax: 1000 } } }
  show linechart "Fillrate on Last 30 Days" a9f11   with
    Day.RandomNewFR * 100 as "New Fillrate" {seriesType: area ; color: #7fc779 ; areaTo: 75 ; seriesOpacity: 0.1 ; seriesLegend: hidden}//{color: #7fc779}//
    Day.RandomNewFR * 100 as "New Fillrate" {color: #7fc779 ; seriesSmooth: cubic}//{color: #7fc779}//
    Day.RandomCurrentFR * 100 as "Fillrate" {color: "1A56DB" ; seriesSmooth: cubic}//{color: "1A56DB"}//
    Day.RandomCurrentFR * 100 as "Fillrate" {seriesType: area ; color: "1A56DB" ; areaTo: 75 ; seriesOpacity: 0.1 ; seriesLegend: hidden}//{color: "1A56DB"}//

//Tiletab : Parameters, Alerts and Documentation
///Alerts and Checks

currentTab = "Parameters, Alerts and Documentation"
//Form

show form "Maximum Capacity (units/day)" c3d4 {tileTab: #(currentTab) ; formButton: #(ConfirmButton) ; backgroundColor: #(GP.yellowlight)} with constraints

////Alerts section

show label "Sanity checks on dispatch suggestions"    a6f6             {labelBorder: "none" ; textBold: "true" ; textAlign: center ; tileTab: #(currentTab)}
show summary "" a7f8 {tileTab: #(currentTab) ; backgroundColor: #(backgroundColorforsummarytile)} with ""

where any(Skus.NewStockWarehouse == 0 and Skus.StockAvailableForDispatch > 0) by Skus.Ref

  issueName = "Stock out in DC after Dispatch"
  failedLines = distinct(Skus.Ref)
  repColor = if failedLines > 0 then ColorWarning else ""
  EmoAtt = if failedLines > 0 then "⚠️" else ""
  description = "1 line per Sku for all the Refs for which the dispatch decisions led to a stock out in the central location."
  show table "\{EmoAtt} \{issueName}" a7f8 {tileTab: #(currentTab) ; tileColor: #(repColor) ; tileTooltipText: #(description)}      with
    Skus.Sku as "Sku"  {href: #[Skus.Url_ItemInspector]}
    Skus.Ref
    Skus.Loc
    Skus.Category as "Category"
    Skus.TotalLTWeeks as "Lead Time" {unit: " week(s)"}
    Skus.StockOnHand as "Stock On Hand" {unit: #(pcsUnit)}
    Skus.StockOnOrder as "Stock On Order" {unit: #(pcsUnit)}
    Skus.DispatchQuantity as "Dispatch suggestion" {cellBackground: #d1d1d1 ; textColor: #C7180F ; unit: #(pcsUnit)}
    Skus.CurrentFRForDisplay as "Current FR" {numbers: percent}
    Skus.NewFR as "New FR" {numbers: percent}
    Skus.StockAvailableForDispatch as "Stock in DC before Dispatch" {unit: #(pcsUnit)}
    Skus.NewStockWarehouse as "Stock in DC after Dispatch" {unit: #(pcsUnit)}
    order by - Skus.DispatchQuantityWarehouse

  show assert "⚠️ Too many stock outs in DC after dispatch" d30f30  {tileTab: "Main" ; tilePlacement: #(if failedLines < 10 then "hidden" else "fixed")} with
    failedLines < 10 as "⚠️ Too many stock outs in DC after dispatch"
    all(Skus.NewStockWarehouse >= 0) as "⚠️ Negative stock in DC after Dispatch"

show label "Documentation"  a12f12 {labelBorder: "none" ; textBold: "true" ; textAlign: center ; tileTab: #(currentTab)}



show markdown "Overall view" a13e20 {tileTab: #(currentTab)} with  """
### Documentation Dispatch Suggestions

  This explanation uses examples of the scenario with an input target FR of 90%. For other input values the results will be a bit different but the general ideas remain valid.

  #### Fill rate

  The target fill rate is used to limit the amount of stock you'd like to ship to the downstream warehouses. It is important to be able to control
  this as we assume here that, once the stock is shipped to one of the downstream locations, it is stuck there.

  ##### Things to notice regarding the overall FR:
  * The overall fill rate increases: thanks to this dispatch optimization, we make the most of the stock we have. We lose a little bit of FR in DC
  to win more in the other locations -> we move the stock to the locations where it has the most impact.
  * We reach 90% FR for EDB and LON: we reached the limit set by the target FR. There could be extra dispatch decisions that could make sense but,
  through the parameters selected, we decided that we'd rather keep the stock in DC and keep options for a future dispatch decision.
  * We are above 90% for MAN: we are already well above the target at MAN so it is not worth it to dispatch anything there.
  * We do not have any products for which the dispatch empties the stock in DC. This is a possibility that might happen if there is very few demand in DC compared to the downstream locations and/or
  there is an imminent stock arrival in DC.

  #### Underlying hypotheses:

  The window of opportunity considered for the warehouses are:
  * The redispatch period (3 or 4 weeks) for the dowstream locations. It is the shortest time between 2 possible stock arrivals (assuming the SLT for the purchase is bigger than this which is the case here)
  * The SLT for DC. It is a much larger location but, as there is no dispatch possible for DC, we need to have enough stock to cover at least from here to the next stock arrival, that can't happen before 1 SLT.

  Having a larger horizon considered for DC is one way of pushing the optimization to prefer keeping stock in the upstream warehouse.
  Another way is to increase the stock aggressiveness for DC. Here we set it up to be twice as big for DC.


"""


////----------------------------------Tab "Mid Term Simulation"---------------------///////////////

currentTab = "Mid Term Simulation"



SimulationStandard.constraints = constraints

show linechart "Simulated Dispatch Quantities over a month" a5g8 {tileTab: #(currentTab)}  with
  round(sum(SimulationStandard.OrderedQty)) as "Dispatch Qty" {seriesFan: 1 ; seriesType: bar ; seriesLegendRank: "2" ; color: #(GP.blue)}
  round(sum(SimulationStandard.StockDelivered)) as "Receptions" {seriesFan: 2 ; seriesType: bar ; seriesLegendRank: "3" ; color: #(GP.colorSkyBlue)}
  same(SimulationStandard.constraints) as "Capacity constraint"{color: "red"}
  0 as "" {seriesFan: 4 ; seriesType: bar ; seriesLegendRank: "4" ; color: "white" ; seriesDisplay: "false"}
  group by SimulationStandard.DispatchDate

SimulationStandard.Margin = SimulationStandard.OrderedQty * (Skus.M)
SimulationStandard.CumQtyByDayByMargin = cumsum(SimulationStandard.OrderedQty) by (SimulationStandard.DispatchDate) scan -SimulationStandard.Margin

where SimulationStandard.OrderedQty > 0
  show table "Daily dispatch anticipated" a9g9 {tileTab: #(currentTab)}  with
    Skus.Ref
    SimulationStandard.Sku
    SimulationStandard.DispatchDate
    SimulationStandard.OrderedQty as "Quantity"
    SimulationStandard.Margin

SimulationStandard.TotalOrderedQtyPerDay = sum(SimulationStandard.OrderedQty) by SimulationStandard.DispatchDate

Day.QteSimuStandard = sum(SimulationStandard.OrderedQty) by SimulationStandard.DispatchDate at Day.date
Day.OverDispatch = max(0,Day.QteSimuStandard-constraints)
Day.LeftCapacity = max(0,constraints-Day.QteSimuStandard)
Day.MarginAtRisk = sum(abs(SimulationStandard.Margin)) when (SimulationStandard.CumQtyByDayByMargin > constraints)  by SimulationStandard.DispatchDate at Day.date
totaloverdispatch = sum(Day.OverDispatch) when (month(Day.date) == GP.monthdispatchflux)
totaloverleftcapacity= sum(Day.LeftCapacity) when (month(Day.date) == GP.monthdispatchflux)
totalmarginatRisk= sum(Day.MarginAtRisk) when (month(Day.date) == GP.monthdispatchflux)

emojicapacity = if totaloverleftcapacity > totaloverdispatch then "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=4D3CDB0DCF11F315C19E04CB64DEABB0&path=%2FImages&name=GreenBox.png"
    else "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=9570B3A9793601A152A88FBFF93FEACA&path=%2FImages&name=RedBox-24.png"

textlabellissagecolor = if totaloverleftcapacity > totaloverdispatch then "#06990b" else "red"
show label "Rebalancing possible" f4g4  {labelBorder: "none" ; tileTab: #(currentTab) ; tileColor: #(textlabellissagecolor)}
show label emojicapacity e4 {tileTab: #(currentTab)}

totaloverdispatchcolor = if totaloverdispatch > 0 then "red" else ""

show summary "" a4d4 {tileTab: #(currentTab) ; backgroundColor: #(GP.colorSkyBlue)} with ""
show label "Main KPIs" a3g3 {tileTab: #(currentTab)}
show scalar "# Days > constraints" a4 {unit: " days" ; tileTab: #(currentTab)} with
  distinct(SimulationStandard.DispatchDate) when (SimulationStandard.TotalOrderedQtyPerDay > constraints) as ""
show scalar "Qty above constraints" b4 {numbers: simple ; tileTab: #(currentTab) ; unit: #(GP.pcsUnit) ; textColor: #(totaloverdispatchcolor)} with
  totaloverdispatch as ""
show scalar "Leftover capacity" c4 {numbers: simple ; tileTab: #(currentTab) ; unit: #(GP.pcsUnit)} with
  totaloverleftcapacity as ""
show scalar "Margin in danger" d4 {numbers: simple ; tileTab: #(currentTab) ; unit: #(GP.DcUnit)}with
  totalmarginatRisk as ""

show label "Dispatch flows rebalancing" a10g10 {tileColor: #(GP.blue) ; tileTab: #(currentTab)}

where month(Day.date) == month(2023,04)
  SimulationStandard.IsOverdispatch = SimulationStandard.CumQtyByDayByMargin > constraints
  totaloverdispatch = sum(SimulationStandard.OrderedQty) when (SimulationStandard.IsOverdispatch)

  Day.NewConstraints = ceiling(min(constraints,Day.QteSimuStandard + totaloverdispatch*Day.LeftCapacity/.totaloverleftcapacity))
  Day.NewLeftCapacity = Day.NewConstraints - Day.QteSimuStandard
  SimulationStandard.Produit = Skus.Ref

  where SimulationStandard.OrderedQty > 0
    where Day.NewLeftCapacity > 0
      Day.Rank = rankrev () scan -Day.date
      SimulationStandard.CountDay = count(Day.*) by 1


      where SimulationStandard.IsOverdispatch



        table T = extend.range(SimulationStandard.CountDay)
        T.SaleIdentifier = concat(SimulationStandard.Produit,"-",SimulationStandard.DispatchDate,"-",SimulationStandard.Sku)
        T.SoldSku = SimulationStandard.Sku
        T.SoldQty = SimulationStandard.OrderedQty
        T.SaleDate = SimulationStandard.DispatchDate
        T.Margin = SimulationStandard.Margin

        T.PurchaseIdentifier = same(concat(Day.date,"-",Day.LeftCapacity)) by Day.Rank at T.N
        T.PurchaseQty = same(Day.NewLeftCapacity) by Day.Rank at T.N
        T.PurchaseDate = same(Day.date) by Day.Rank at T.N

        T.AssociatedQuantity = assoc.quantity(T.SaleIdentifier,T.SoldQty,T.PurchaseIdentifier,T.PurchaseQty) sort [T.SaleDate,T.PurchaseDate,-T.Margin]

  startSimulationDate = min(SimulationStandard.DispatchDate)
  SimulationStandard.AddedNewLissedQty = sum(T.AssociatedQuantity) when (T.AssociatedQuantity > 0) by [T.SoldSku,T.PurchaseDate] at [SimulationStandard.Sku,SimulationStandard.DispatchDate]
  SimulationStandard.RetrievedNewLissedQty = sum(T.AssociatedQuantity) when (T.AssociatedQuantity > 0) by [T.SoldSku,T.SaleDate] at [SimulationStandard.Sku,SimulationStandard.DispatchDate]

  SimulationStandard.NewDailyDispatchedQty = SimulationStandard.OrderedQty + SimulationStandard.AddedNewLissedQty - SimulationStandard.RetrievedNewLissedQty

  SimulationStandard.NewStockDeliveredAfterLissage = if SimulationStandard.DispatchDate < startSimulationDate + 7 then SimulationStandard.StockDelivered
      else same(SimulationStandard.NewDailyDispatchedQty) by [SimulationStandard.Sku,SimulationStandard.DispatchDate + 7] at [SimulationStandard.Sku,SimulationStandard.DispatchDate]

  SimulationStandard.TotalNewDailyDispatchedQty = sum(SimulationStandard.NewDailyDispatchedQty) by SimulationStandard.DispatchDate

  totaloverdispatchafterlissage = sum(max(0,SimulationStandard.TotalNewDailyDispatchedQty - constraints)) when (argwhichever() by SimulationStandard.DispatchDate)

  textlabellissagecolor = if totaloverdispatchafterlissage == 0 then "#06990b" else "red"
  emojicapacity = if totaloverdispatchafterlissage == 0 then "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=4D3CDB0DCF11F315C19E04CB64DEABB0&path=%2FImages&name=GreenBox.png"
      else "https://go.lokad.com/DEMO/gateway/BigFiles/Browse/Download?hash=9570B3A9793601A152A88FBFF93FEACA&path=%2FImages&name=RedBox-24.png"

  show label "Rebalancing completed" f11g11  {labelBorder: "none" ; tileTab: #(currentTab) ; tileColor: #(textlabellissagecolor)}
  show label emojicapacity e11 {tileTab: #(currentTab)}

  show linechart "Rebalanced Dispatch Quantity" a12g15 {tileTab: #(currentTab)}  with
    round(sum(SimulationStandard.OrderedQty + SimulationStandard.AddedNewLissedQty - SimulationStandard.RetrievedNewLissedQty)) as "Dispatch Qty" {seriesFan: 1 ; seriesType: bar ; seriesLegendRank: "2" ; color: #(GP.blue)}
    round(sum(SimulationStandard.NewStockDeliveredAfterLissage)) as "Receptions" {seriesFan: 2 ; seriesType: bar ; seriesLegendRank: "3" ; color: #(GP.colorSkyBlue)}
    same(SimulationStandard.constraints) as "Capacity constraint"{color: "red"}
    0 as "" {seriesFan: 4 ; seriesType: bar ; seriesLegendRank: "4" ; color: "white" ; seriesDisplay: "false"}
    group by SimulationStandard.DispatchDate

  SimulationStandard.NewOrderedQtyAfterLissage = SimulationStandard.OrderedQty + SimulationStandard.AddedNewLissedQty -  SimulationStandard.RetrievedNewLissedQty
  SimulationStandard.NewLissedCumQtyByDayByMargin = cumsum(SimulationStandard.NewOrderedQtyAfterLissage) by (SimulationStandard.DispatchDate) scan -SimulationStandard.Margin

  where SimulationStandard.NewOrderedQtyAfterLissage> 0
    show table "Smoothed Daily dispatch anticipated" a16g16 {tileTab: #(currentTab)}  with
      SimulationStandard.Produit
      SimulationStandard.Sku
      SimulationStandard.DispatchDate
      SimulationStandard.OrderedQty as "Quantity"

  show summary "KPIs" a11d11 {textAlign: center ; tileTab: #(currentTab) ; backgroundColor: #(GP.colorSkyBlue)} with
    distinct(SimulationStandard.DispatchDate) when (SimulationStandard.TotalNewDailyDispatchedQty > constraints) as "# Days > constraints" {unit: " days"}
    totaloverdispatchafterlissage as "Qty above constraints" {numbers: simple ; unit: #(GP.pcsUnit)}
    sum(SimulationStandard.Margin) when (SimulationStandard.NewLissedCumQtyByDayByMargin > constraints) as "Margin in danger" {numbers: simple ; unit: #(GP.DcUnit)}
