///
// Cloned from '/Optimization workflow/5 Standard Purchase Suggestion' (see https://go.lokad.com/Dashboard/50158) on 2021-12-07

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// --------------------------------------READ INPUT TABLES-----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
import "/1. utilities/Modules/Global Parameters" as GP

const testStorage = ""
const inputPath = "\{testStorage}/Clean/"

read "\{inputPath}Items.ion" as Items[Id unsafe] with
  "Sku" as Id : text
  Name : text
  Category : text
  SellPrice : number
  BuyPrice : number
  StockOnHand : number
  StockOnOrder : number
  LeadTime : number
  ImageUrl : text
  StartDate : date
  EndDate : date
  Supplier : text


read "/Manual/TopItemsParameters.xlsx" as TopItemsParameters expect[Id] with
  CategoryDisplayRank : number
  Category : text
  ItemDisplayRank : number
  Ref : text
  "Sku" as Id : text

read "\{testStorage}Clean/Orders.ion" as Orders expect [Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  Ref : text
  Loc : text
  Quantity : number
  LokadNetAmount : number
  OrderId : text
  IsFirstOrder : boolean
  HealthLog : text
  IsClean : boolean

read "/Clean/PO.ion" as PO expect[Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  Loc : text
  Ref : text
  DeliveryDate : date
  Quantity : number
  Supplier : text
  PONumber : text
  IsInCatalog : boolean
  IsClean : boolean
  InputDate : date
  InputPath : text

read "/Clean/Stock.ion" as Stock expect[Id, date] with
  "Sku" as Id : text
  StockOnHand : number
  StockOnOrder : number
  "StockDate" as date: date
  IsInCatalog : boolean
  InputDate : date
  InputPath : text

read "\{inputPath}Forecast/Periodic/WeeklyFc.ion" as WeeklyFc expect[Id, date] with
  "Sku" as Id : text
  "Monday" as date: date
  WOODemand : ranvar
  SLTDemand : ranvar
  TotalDemand : ranvar
  IsPast : boolean
  FutureWeekRank : number
  IsSLT : boolean
  IsWOO : boolean
  Alpha : number
  Dispersion : number
  Baseline : number

read "Clean/PurchaseResults/PORecommendations.ion" as PORecommendations expect[Id] with
  Id : text
  Margin : number
  BuyPrice : number
  OrderQuantity : number
  InvestmentRequired : number
  CurrentFR : number
  NewFR : number
  LastYearSales : number
  SalesWeight : number
  OverallFRContrib : number
  SupplierLastYearSales : number
  SupplierSalesWeight : number
  SatisfiableDemand : ranvar

read "Clean/PurchaseResults/MicroDecisions.ion" as MicroDecisions expect[Id] with
  Rank : number
  "SKU" as Id : text
  Name : text
  Supplier : text
  BuyPrice : number
  SellPrice : number
  Margin : number
  StockOnHand : number
  StockOnOrder : number
  LotMultiplier : number
  Q : number
  Min : number
  Max : number
  SLT : number
  RLT : number
  SalesWeight : number
  CurrentFR : number
  FillRateDelta : number
  CumFillrateDelta : number
  M : number
  S : number
  C : number
  Reward : number
  Score : number
  Investment : number
  CumInvest : number
  IsEligible : boolean


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// ------------------------------------------SETUP-------------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Editable body------------------------------------------------------------------------------------

show logo "" a1
show markdown "Strategy comparison" b1h1 with """
  ### **Strategy comparison**
"""

show label "Welcome to your Lokad cockpit" d21 000000 {textAlign: center ; labelBorder: "none"}

show markdown "" b21 with """
  __This dashboard provides a purchase suggestion utilizing the ROI optimization of probablistic forecasts.__
  __See full documentation below__
"""
show label "" a2h2 9b9b9b {labelBorder: "top"}


show label "" a13h13 9b9b9b {labelBorder: "top"}

// show label "Next" h1                    {href: "https://go.lokad.com/home" ; hrefAspect: white ; textAlign: center}
// show label "Back" g1                    {href: "https://go.lokad.com/d/51250/" ; hrefAspect: white ; textAlign: center}


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------------PREPROCESS----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~





Items.SupplierLastYearSales = same(PORecommendations.SupplierLastYearSales)
table Slices [slice] = slice by [-Items.SupplierLastYearSales, Items.Supplier] title: Items.Supplier

Items.TotalDemand = same(WeeklyFc.TotalDemand)


oend = max(Orders.date)
keep span date = [oend..oend+299]

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------------SIMULATIONS---------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

// Items.SimpleMaxDemandWOO = sum(WeeklyFc.Baseline * (1 + 3 * Items.Dispersion)) when WeeklyFc.IsWOO
// Items.MaxQuantity = Items.StockOnHand + Items.StockOnOrder + max(Items.MOQ, Items.SimpleMaxDemandWOO)
// table Q = extend.range(max(Items.MaxQuantity) into scalar)
// expect table Q max 1m
// table ItemsQ = cross(Items, Q)


