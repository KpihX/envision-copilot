// ///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// ///----------------------------------------PARETO-------------------------------------------
// ///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

// lastYearOverallSales = sum(PORecommendations.LastYearSales)

// PORecommendations.CumSupplierLastYearSales = -1
// where argwhichever() by Items.Supplier
//   PORecommendations.CumSupplierLastYearSales = sum(PORecommendations.SupplierLastYearSales) scan - PORecommendations.SupplierLastYearSales
// PORecommendations.CumSupplierLastYearSales = same(PORecommendations.CumSupplierLastYearSales)
//                                               when(PORecommendations.CumSupplierLastYearSales != -1)
//                                               by Items.Supplier

// show barchart "Pareto at Supplier level" a21c23                        {barchartGroups: bottom} with
//   0 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden ; unit: " overall sales"}
//   1 as "" {numbers: percent ; color: #ffffff ; seriesType: bar ; seriesLegend: hidden}
//   sum(PORecommendations.NewFR * PORecommendations.SupplierSalesWeight) as "New FR" {numbers: percent ; seriesType: bar ; color: #fdc488}
//   sum(PORecommendations.CurrentFR * PORecommendations.SupplierSalesWeight) as "Current FR" {numbers: percent ; seriesType: bar ; color: #ec9539}
//   same(PORecommendations.CumSupplierLastYearSales / lastYearOverallSales) as "% Sales" {numbers: percent ; unit: " overall sales" ; seriesPattern: dotted}
