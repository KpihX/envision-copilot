//       return (Quantity, StockDev, Qserved, CumulQ)
//     EndWOOStock = last(week.StockDev) sort Day.date when week.IsRLT
//     EndWOODemand = last(week.CumulQ) sort Day.date when week.IsRLT

//     // StartWOOStock = last(Day.StockDev) sort Day.date when Day.IsSLT
//     // sample rv = ranvar(-EndWOOStock)
//     // sample dmd = ranvar(EndWOODemand)
//     sample week.Demand = ranvar(week.CumulQ)
//     // sample week.LostSales = sum(week.Qserved)
//   return (rv, dmd, week.AvgEndStock)


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///---------------------------------PURCHASE RECOMMENDATIONS--------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

target = 0.98

Items.TotalRec = sum(PORecommendations.InvestmentRequired)
table StockMorph = extend.range(Items.2)
StockMorph.Type = if StockMorph.N == 1 then "Existing Stock" else "Ideal Stock"
StockMorph.TotalStock = if StockMorph.N == 1 then (Items.StockOnHand + Items.StockOnOrder)*Items.BuyPrice else 0
StockMorph.DeadStock = 0.1 * StockMorph.TotalStock
StockMorph.PrematureStock = 0.2 * StockMorph.TotalStock
StockMorph.StockOK = StockMorph.TotalStock - StockMorph.DeadStock - StockMorph.PrematureStock
StockMorph.StockOK = max(StockMorph.StockOK) by Id
StockMorph.StockRec = if StockMorph.N == 2 then Items.TotalRec else 0
StockMorph.StockTooLate = 0.1 * StockMorph.StockRec


Items.NonMutedDemand = dirac(round(Items.StockOnHand + Items.StockOnOrder)) + same(PORecommendations.SatisfiableDemand)


Items.LotMultiplier = 1
table G = extend.ranvar(Items.NonMutedDemand, 0, Items.LotMultiplier, round(Items.StockOnHand + Items.StockOnOrder)) //add a reach if needed
///Qty
G.Q = G.Max - G.Min + 1
keep where G.Min > 0
Items.FR = fillrate(Items.NonMutedDemand)
G.FillRateDelta = int(Items.FR, G.Min, G.Max)
G.OverallFRDelta = G.FillRateDelta * mean(Items.NonMutedDemand)/(sum(mean(Items.NonMutedDemand)) by 1)
Items.SellThrough = (1 - cdf(Items.NonMutedDemand + 1))
G.SaleProbability = int(Items.SellThrough, G.Min, G.Max)/G.Q
G.IsInStock = (G.Max <= (Items.StockOnHand + Items.StockOnOrder))
Items.SuggestedStock = same(PORecommendations.OrderQuantity) + Items.StockOnHand + Items.StockOnOrder
G.IsSuggested = (G.Max <= Items.SuggestedStock) and not(G.IsInStock)

where G.IsInStock
  G.CurrentFillRateContribution = sum(G.OverallFRDelta) scan -G.SaleProbability
  currentFillRate = max(G.CurrentFillRateContribution)

G.IdealFRContribution = sum(G.OverallFRDelta) scan -G.SaleProbability
G.IsIdealTarget = (G.IdealFRContribution <= target)
G.IsIdealEquivalentCurrent = (G.IdealFRContribution <= min(target,currentFillRate))

show table "G" c21       with
  G.Id as "Id"
  G.Min as "Min"
  G.Max as "Max"
  G.Q as "Q"
  G.Q * Items.BuyPrice as "Cost"
  G.FillRateDelta as "FillRateDelta"
  G.SaleProbability as "SaleProbability"
  G.IsInStock as "IsInStock"
  G.IsSuggested as "IsSuggested"
  G.IdealFRContribution as "IdealFR"
  G.IsIdealTarget as "IsIdealTarget"

G.Haxis = round(G.SaleProbability*20)*5
show chart "Current Stock Efficiency - Stock ranked by probability of selling over next cycle" a3d11 with
  haxis by text(G.Haxis)
    order by same(-G.Haxis)
  plot by text(G.Haxis)
    sum(G.Q * Items.BuyPrice) when (G.IsInStock) as "Current Stock" {seriesType: bar ; seriesStack: "stack" ; color: #b3cab3}
    sum(G.Q * Items.BuyPrice) when (not(G.IsIdealTarget) and G.IsInStock) as "of which ineffective Stock" {seriesType: bar ; seriesStack: "stackOther" ; color: #d88383}
    sum(G.Q * Items.BuyPrice) when (G.IsIdealTarget and not(G.IsInStock)) as "Missing Stock" {seriesType: bar ; seriesStack: "stack" ; color: #3db45e}


show scalar "Current FR" f4g4 {unit: "%" ; textAlign: center ; textBold: "true"} with currentFillRate*100
show scalar "Target FR" e9f9 {unit: "%" ; textAlign: center ; textBold: "true"} with target*100

where G.IsInStock
  G.Statut = if G.IsIdealTarget then "Optimal" else "Ineffective"
  show piechart "Test3" c19d20 with
    sum(G.Q * Items.BuyPrice)
    group by G.Statut

currentefficiency = sum((Items.StockOnHand + Items.StockOnOrder)*Items.BuyPrice)/(100*min(currentFillRate, target))
show scalar "Current Efficiency: cost per point of FR" f5 {textAlign: center} with
  currentefficiency {unit: "$"}

where G.IsIdealTarget
  idealtargetefficiency = sum(G.Q * Items.BuyPrice) / (100*target)
  show scalar "Could be ideally achieved for" f10 {textAlign: center} with
    idealtargetefficiency {unit: "$"}

where G.IsIdealEquivalentCurrent
  idealcurrentefficiency = sum(G.Q * Items.BuyPrice) / (100*min(currentFillRate, target))
  show scalar "Could have been ideally achieved for" g5 {textAlign: center} with
    idealcurrentefficiency {unit: "$"}

where G.IsSuggested or G.IsInStock
  targetefficiency = sum(G.Q * Items.BuyPrice) / (100 * target)
  show scalar "New efficiency at target" e10 {textAlign: center} with
    targetefficiency {unit: "$"}

show scalar "Current Inefficiency" f6g6 b43636 {textAlign: center ; textBold: "true" ; unit: "%"} with 100 * (currentefficiency/idealcurrentefficiency-1)
show scalar "Target Inefficiency" e11f11 3db45e {textAlign: center ; textBold: "true" ; unit: "%"} with 100 * (targetefficiency/idealtargetefficiency-1)

show label downloadUrl("logo.png") e8f8 {textVerticalAlign: center}
show label downloadUrl("logo.png") h8 {textVerticalAlign: center}
show label downloadUrl("Background/Graphics/Forms/Team.png") f3g3 {textVerticalAlign: center}

Items.TargetCover = 1.08 * mean(Items.TotalDemand)
G.IsCover = G.Max <= Items.TargetCover
FRCover = sum(G.OverallFRDelta) when (G.IsCover or G.IsInStock)
stockCover = sum(G.Q * Items.BuyPrice) when (G.IsCover or G.IsInStock)
show scalar "Cover FR" h9 {unit: "%" ; textAlign: center ; textBold: "true"} with FRCover * 100
show scalar "Cover Efficiency" h10 {textAlign: center ; unit: "$"} with stockCover/(FRCover*100)
show scalar "Cover Inefficiency" h11 {textAlign: center ; textBold: "true" ; unit: "%"} with 100 * ((stockCover/(FRCover*100)) / idealtargetefficiency - 1)

show label "" e8f11 9b9b9b {labelBorder: "all"}
show label "" f3g6 9b9b9b {labelBorder: "all"}
show label "" h8h11 9b9b9b {labelBorder: "all"}





