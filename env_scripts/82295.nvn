/// Functions for SubCat
export def pure SubCatColor(Category: number, SubCategory: number) with
  Color = "black"
  if Category == 1
    Color = match SubCategory with
      1 -> color1
      2 -> color1a
      3 -> color1b
      4 -> color1c
      .. -> color1d
  if Category == 2
    Color = match SubCategory with
      1 -> color2
      2 -> color2a
      3 -> color2b
      4 -> color2c
      .. -> color2d
  if Category == 3
    Color = match SubCategory with
      1 -> color3
      2 -> color3a
      3 -> color3b
      4 -> color3c
      .. -> color3d
  if Category == 4
    Color = match SubCategory with
      1 -> color4
      2 -> color4a
      3 -> color4b
      4 -> color4c
      .. -> color4d
  if Category == 5
    Color = match SubCategory with
      1 -> color5
      2 -> color5a
      3 -> color5b
      4 -> color5c
      .. -> color5d
  if Category == 6
    Color = match SubCategory with
      1 -> color6
      2 -> color6a
      3 -> color6b
      4 -> color6c
      .. -> color6d
  return(Color)
