

read "/Manual/Demo account project phases.xlsx" as Project with
  Phase : text
  PhaseCode : number
  Description : text
  PhaseImageURL : text

show tabs "" a3h3 with
  "Timeline and Milestones"
  "Team"
  "Documentation"

show markdown "" b1e2 with """# Organization
  #### Project timeline, team and main milestones
"""
show markdown "" a16g16 {tileTab: "Timeline and Milestones"} with """# Implementation steps
"""

// show markdown "" b2h2 with """#### Project timeline, team and main milestones"""
show label (downloadUrl("57573E339DB4ABC099E34B31E5DE27FB", "Team.png")) a1a2

Project.PhaseCodeText = text(Project.PhaseCode)
Project.PhaseCodePadded = padLeft(Project.PhaseCodeText, "0", 2)
Project.PhaseId = concat(Project.PhaseCodePadded, " - ", Project.Phase)

