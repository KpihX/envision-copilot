/// Input:  /Clean/

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// --------------------------------------READ INPUT TABLES-----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
import "/1. utilities/Modules/Global Parameters" as GP with
  DcUnit
  ColorB
  LinkLocationItemInspector

const testStorage = ""
const inputPath = "\{testStorage}/Clean/"

read "\{inputPath}Items.ion" as Items[Id unsafe] with
  "Sku" as Id : text
  Name : text
  Category : text
  SellPrice : number
  BuyPrice : number
  StockOnHand : number
  StockOnOrder : number
  LeadTime : number
  ReorderCycle : number
  ImageUrl : text
  StartDate : date
  EndDate : date
  Supplier : text
  IsClean : boolean
  LotMultiplier : number

read "/Manual/TopItemsParameters.xlsx" unsafe as TopItemsParameters expect[Id] with
  CategoryDisplayRank : number
  Category : text
  ItemDisplayRank : number
  Ref : text
  "Sku" as Id : text

read "\{testStorage}Clean/Orders.ion" as Orders expect [Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  Ref : text
  Loc : text
  Quantity : number
  LokadNetAmount : number
  OrderId : text
  IsFirstOrder : boolean
  HealthLog : text
  IsClean : boolean

read "/Clean/PO.ion" as PO expect[Id, date] with
  "Sku" as Id : text
  "OrderDate" as date: date
  DeliveryDate : date
  Quantity : number
  PONumber : text

read "/Clean/Stock.ion" as Stock expect[Id, date] with
  "Sku" as Id : text
  StockOnHand : number
  StockOnOrder : number
  "StockDate" as date: date
  IsInCatalog : boolean
  InputDate : date
  InputPath : text

read "\{inputPath}Forecast/Periodic/WeeklyFc.ion" as WeeklyFC expect[Id, date] with
  "Sku" as Id : text
  "Monday" as date: date
  DemandQty : number
  Cache : number
  IsPast : boolean
  FutureWeekRank : number
  Alpha : number
  Dispersion : number
  Baseline : number
  Demand : ranvar
  LowerBarTotal2 : number
  LowerBarTotal1 : number
  HighBarTotal2 : number
  HighBarTotal1 : number
  CumDemand : ranvar

read "/Clean/Parameters/max_date_placeholder.csv" unsafe as DatePlaceholder expect[date] with
  date: date

read "/Clean/PurchaseResults/EconomicParametersCategories.ion" as EconomicParametersCategories with
  CategoryName : text
  AgressivenessFactor : number

read "/Clean/PurchaseResults/TargetsPurchaseList.ion" as TargetsPurchaseList with
  FRTarget : number
  budgetTarget : number

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// ------------------------------------------SETUP-------------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Colors-------------------------------------------------------------------------------------------

highlightColor =  ColorB


///Global parameters--------------------------------------------------------------------------------
show tabs "" a3h3 with
  "OverallView" as "Overall View"
  "CategoryView" as "Category View"
  "ItemView" as "Item View"

pcsUnit = " Pcs"
dayUnit = " Days"
magnifierIcon = "🔎"

///Editable body------------------------------------------------------------------------------------

show logo "" a1
show markdown "Economic Parameters Validation" b1d1 with """
  ### **Economic Parameters Validation**
"""

show markdown "Documentation" b2h2                                 {color: #(highlightColor)} with
  """
  __This dasboard presents the parameters that determine the value and cost of a stock decision.__
  """

show markdown "Overall view" a11h18                                            {tileTab: "OverallView"} with  """
### Documentation

__Total Investments__: overall total investment proposed to cover next window of responsibility

__Current Fill Rate on WOO__: overall fill rate associated to the current stock on hand and on order, i.e. the proportion of the demand
already covered by the current stock on hand and on order on the responsibility window

__Achieved Fill Rate on WOO__: overall fill rate associated to the current stock on hand and on order and the recommended purchase suggestions, i.e. the proportion of the demand
which will be covered after purchasing on the responsibility window

__Categories__:

Category: category name

Turnover L365 d: turnover of the category on the last 365 days

Avg COGs on WOO: average sales valued at buy price on the responsibility window

Stock End SLT: average estimated stock value at the end of the next supplier leadtime

Investment required: overall total investment proposed to cover next window of responsibility for the category

__All agressiveness factors__: chosen agressiveness factors by category.

`Stock Agressiveness` - Defines the risk associated for not having an item in stock in a range from 1 to 5. 5 means there is a huge penalty to miss a sale.
1 means there is a low penalty to miss a sale.

__Stock evolution (net amount)__: displays overall past stock amount and overall forecasted future average stock amount, as well as a likely and a plausible area

"""

show markdown "Category view" a10h14                                            {tileTab: "CategoryView"} with  """
### Documentation

__Cosmetic Overview__:

Turnover L365 d: turnover of the category on the last 365 days

Avg COGs on WOO: average sales valued at buy price on the responsibility window

Stock End SLT: average estimated stock value at the end of the next supplier leadtime

Investment required: total investment proposed to cover next window of responsibility for the category

__Agressiveness factor configuration__: form to setup an agressiveness factor for the selected category. Once one change the value,
he must run the dashboard again to save it clicking on the "run" button

__Stock evolution (net amount)__: for the selected category, displays overall past stock amount and overall forecasted future average stock amount, as well as a likely and a plausible area

"""

show markdown "Item view" a26h33                                            {tileTab: "ItemView"} with  """
### Documentation

__Magnifying glass icon__: link to the item inspector dashboard which displays all information of the given reference

__Reference summary__:

Buy Price: gross buy price in dollars

Sell Price: gross sell price in dollars

Avg Sales on WOO: average observed sales on a responsibility window horizon the last 365 days

Stock End SLT: average estimated stock units at the end of the next supplier leadtime

__Investment decision__

Investment: total units proposed to cover next window of responsibility for the reference

Investment ($): total investment proposed in dollars to cover next window of responsibility for the reference

Current FR: overall fill rate associated to the current stock on hand and on order, i.e. the proportion of the demand
already covered by the current stock on hand and on order on the responsibility window

New FR: overall fill rate associated to the current stock on hand and on order and the recommended purchase suggestions, i.e. the proportion of the demand
which will be covered after purchasing on the responsibility window

__Start Week Stock Evolution__: displays overall past stock units and overall forecasted future average stock units, as well as a likely and a plausible area

"""

show label "" a2h2 9b9b9b


show label "Next" h1                {href: "https://go.lokad.com/d/68021/" ; hrefAspect: white ; textAlign: center}
show label "Back" g1                {href: "https://go.lokad.com/d/68019/" ; hrefAspect: white ; textAlign: center}

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------PREPROCESS----------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Global parameters--------------------------------------------------------------------------------

keep where Items.IsClean

table ItemsWeek = cross(Items, Week)

oend = max(WeeklyFC.date) when(WeeklyFC.IsPast)
now = oend

Week.monday = same(monday(date))

lastPastWeek = max(WeeklyFC.date) when(WeeklyFC.FutureWeekRank == 0)
WeeklyFC.IsLastPastWeek = WeeklyFC.date == lastPastWeek

lookbackDays = 52 * 7
hStart = now - lookbackDays
lookforwardDays = 26 * 7
historyWks = lookbackDays + lookforwardDays
FRTarget = single(TargetsPurchaseList.FRTarget)
budgetTarget = single(TargetsPurchaseList.budgetTarget)

///Links to inspectors
inspectorId = LinkLocationItemInspector
selectedTab = concat("&t=", "Info")
Items.hRefUrlRaw = sliceSearchUrl(inspectorId, Items.Id)
Items.hRefUrl = concat(Items.hRefUrlRaw, selectedTab)
Items.Url = replace(Items.hRefUrl , "~" , "https://go.lokad.com" )

///Item level Sales 365
Items.SalesL365 = sum(WeeklyFC.DemandQty) when (WeeklyFC.date > oend - 365)
Items.SalesN365 = sum(WeeklyFC.Baseline) when(WeeklyFC.date > now and WeeklyFC.date <= now + 365)

Items.TurnoverL365 = sum(WeeklyFC.DemandQty * Items.SellPrice) when (WeeklyFC.date > oend - 365 and WeeklyFC.date <= oend)
Items.TurnoverN365 = sum(WeeklyFC.Baseline * Items.SellPrice) when(WeeklyFC.date > now and WeeklyFC.date <= now + 365)

///Category level Sales 365
Items.CategoryTurnoverL365 = sum(Items.TurnoverL365) by Items.Category
Items.CategoryTurnoverN365 = sum(Items.TurnoverN365) by Items.Category

///Slices-------------------------------------------------------------------------------------------

Items.CategoryDisplayRank = same(TopItemsParameters.CategoryDisplayRank)
                            by TopItemsParameters.Category
                            at Items.Category

Items.ItemDisplayRank = same(TopItemsParameters.ItemDisplayRank)

Items.PageName = Items.Category
Items.PagePosition = Items.ItemDisplayRank
where Items.ItemDisplayRank > 0
  Items.PagePosition = rankrev () by Items.PageName scan -Items.ItemDisplayRank

table Slices [slice] = slice by [Items.CategoryDisplayRank, Items.PageName] title: Items.PageName
Slices.PageName = same(Items.PageName)
Slices.Category = same(Items.Category)

///References attributes----------------------------------------------------------------------------
// Items.LotMultiplier = if Items.Id == "DS-124-EDB" then 40 else 1 //moved to preprocess

///Stocks-------------------------------------------------------------------------------------------

Stock.StockOnHand = max(Stock.StockOnHand,0)
WeeklyFC.WkStockOnHand = same(Stock.StockOnHand) by [Id, Stock.date] at [Id, WeeklyFC.date]

///Purchase orders----------------------------------------------------------------------------------

///Arrival
PO.ArrivalTime = max(ceiling((PO.DeliveryDate - lastPastWeek)) / 7, 0)

///Leadtimes----------------------------------------------------------------------------------------

Items.ReorderCycleWeeks = ceiling(Items.ReorderCycle / 7)

Items.SupplierLTWeeks = ceiling(Items.LeadTime / 7)

Items.TotalLTWeeks = Items.SupplierLTWeeks + Items.ReorderCycleWeeks

WeeklyFC.IsSupplierLT = WeeklyFC.date >= lastPastWeek and WeeklyFC.FutureWeekRank + 1 <= Items.SupplierLTWeeks
WeeklyFC.IsNextReorderCycle = WeeklyFC.FutureWeekRank + 1 > Items.SupplierLTWeeks and WeeklyFC.FutureWeekRank + 1 <= Items.TotalLTWeeks
WeeklyFC.IsBeforeReorderCycle = WeeklyFC.date == max(WeeklyFC.date) when(WeeklyFC.IsSupplierLT) by Items.Id

///Forecast-----------------------------------------------------------------------------------------

keep where PO.DeliveryDate > oend + 7
keep where Stock.date <= oend

WeeklyFC.MeanQty =  max(quantile(WeeklyFC.Demand, 0.5 ), 0)

//Dispersion at overall level
myDiffTotal1 = 0.40
myDiffTotal2 = 0.20
WeeklyFC.LowerBarTotal2 =   max(quantile(WeeklyFC.Demand, 0.5 - myDiffTotal1), 0 )
WeeklyFC.HighBarTotal2 =  max(quantile(WeeklyFC.Demand, 0.5 + myDiffTotal1), 0 )
WeeklyFC.LowerBarTotal1 =  max(quantile(WeeklyFC.Demand, 0.5 - myDiffTotal2), 0 )
WeeklyFC.HighBarTotal1 =  max(quantile(WeeklyFC.Demand, 0.5 + myDiffTotal2), 0 )

//Dispersion at category level
myDiffGrpLvll1 = myDiffTotal1
myDiffGrpLvll2 = myDiffTotal2
WeeklyFC.LowerBarGrpLvl2 =   max(quantile(WeeklyFC.Demand, 0.5 - myDiffGrpLvll1), 0 )
WeeklyFC.HighBarGrpLvl2 =  max(quantile(WeeklyFC.Demand, 0.5 + myDiffGrpLvll1), 0 )
WeeklyFC.LowerBarGrpLvl1 =  max(quantile(WeeklyFC.Demand, 0.5 - myDiffGrpLvll2), 0 )
WeeklyFC.HighBarGrpLvl1 =  max(quantile(WeeklyFC.Demand, 0.5 + myDiffGrpLvll2), 0 )

//Dispersion at item level
myDiff1 = myDiffTotal1
myDiff2 = myDiffTotal2
WeeklyFC.LowerBarItem1 = max(quantile(WeeklyFC.Demand, 0.5 - myDiff1), 0 )
WeeklyFC.HighBarItem1 = max(quantile(WeeklyFC.Demand, 0.5 + myDiff1), 0 )
WeeklyFC.LowerBarItem2 = max(quantile(WeeklyFC.Demand, 0.5 - myDiff2), 0 )
WeeklyFC.HighBarItem2 = max(quantile(WeeklyFC.Demand, 0.5 + myDiff2), 0 )

//Quantile 95
myDiffToQ95 = 0.45
quantileDisplay = (0.5 + myDiffToQ95) * 100
WeeklyFC.HighBarToQ95 = max(quantile(WeeklyFC.Demand, 0.5 + myDiffToQ95), 0 )

///Economic kpis------------------------------------------------------------------------------------

///Agressiveness factor input

Items.AgressivenessFactorIni = same(EconomicParametersCategories.AgressivenessFactor) by EconomicParametersCategories.CategoryName at Items.Category
Items.AgressivenessFactor = max(min(Items.AgressivenessFactorIni / 5, 1), 0.2)

///Economic parameters
//Margin
Items.M = Items.SellPrice - Items.BuyPrice

//OOS penalty
Items.S = - Items.AgressivenessFactor * Items.M

//Carrying cost
carryingCost = 0.2 // % per-period carrying cost relative to purchase price
Items.C = carryingCost * Items.BuyPrice * 7 / 365


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///----------------------------------------PURCHASE LIST--------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Action reward call--------------------------------------------------------------------------------

WeeklyFC.PreviousCumDemand = dirac(0)

Items.Dispersion = same(WeeklyFC.Dispersion) default 1
Items.Alpha = same(WeeklyFC.Alpha)
trajectoryCount = 500

// where Items.Id == "DS-204-DC"
//   show table "PO issues"   with
//     PO.date as "date"
//     PO.Id as "Id"
//     PO.DeliveryDate as "DeliveryDate"
//     PO.Quantity as "Quantity"
//     PO.PONumber as "PONumber"
//     PO.ArrivalTime as "ArrivalTime"
//     Items.SupplierLTWeeks

where WeeklyFC.FutureWeekRank > 0
  ///Satisfiable demand and Holding time
  Items.SatisfiableDemand, Items.HoldingTime = actionrwd.reward(
    TimeIndex: WeeklyFC.FutureWeekRank,
    Baseline: WeeklyFC.Baseline,
    Dispersion: Items.Dispersion,
    Alpha: Items.Alpha,
    StockOnHand: Items.StockOnHand,
    StockOnOrder : PO.Quantity,
    ArrivalTime : dirac(ceiling(PO.ArrivalTime)), //dirac(0) --> considered as stock on hand, error if < 0
    LeadTime: dirac(Items.SupplierLTWeeks),
    StepOfReorder: Items.ReorderCycleWeeks,
    Samples: trajectoryCount,
    Seed: 1)

  //Total demand computed just for display purposes
  Items.TotalDemandRLTDisplay = actionrwd.segment(
    TimeIndex: WeeklyFC.FutureWeekRank,
    Baseline: WeeklyFC.Baseline,
    Dispersion: Items.Dispersion,
    Alpha: Items.Alpha,
    Start: dirac(Items.SupplierLTWeeks),
    Duration: dirac(Items.ReorderCycleWeeks),
    Samples: trajectoryCount,
    Seed: 1)

  WeeklyFC.PreviousCumDemand = same(WeeklyFC.CumDemand)
                                when(WeeklyFC.FutureWeekRank != 0)
                                by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                                at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1]

  ///Satisfied demand
  Items.AvgDemandOnRLT = sum(WeeklyFC.Baseline)
                          when(WeeklyFC.FutureWeekRank >= Items.SupplierLTWeeks and WeeklyFC.FutureWeekRank < Items.TotalLTWeeks)
  Items.SatisfiedDemand = round(Items.AvgDemandOnRLT - mean(Items.SatisfiableDemand))

  ///New all RLT demand rebuilt
  //Total demand computed for FR calculation purposes
  //There seems to be an edge case not handled (https://go.lokad.com/d/68009/8596518/3-inspectors-1-item-inspector?s=103&t=PO%20Recommendations for instance)
  //but not too big a deal for FR, however issue for display because we would be showing a negative demand.
  //Hence the method above for display only.
  Items.TotalDemandRLT = Items.SatisfiableDemand + dirac(Items.SatisfiedDemand)

  ///Sell through
  //SellThrough: probability to sell a specific unit of the satisfiable demand on responsibility window
  //Ex: probability of selling the 6th unit = probability of selling exactly 6 units + probability of selling exactly 7 units +
  // ... probability of selling the maximum of the satisfiable demand
  Items.SellThrough = (1 - cdf(Items.SatisfiableDemand + 1)) * uniform.right(1) //values in negative are not relevant

///Purchase list------------------------------------------------------------------------------------

  ///Grid
  //Action reward considers the additional units to purchase so the Grid has to start at 1
  table Grid = extend.ranvar(Items.SatisfiableDemand, 0, Items.LotMultiplier) //add a reach if needed

  ///Qty
  Grid.Q = Grid.Max - Grid.Min + 1

  ///Fill rate
  Items.FR = fillrate(Items.TotalDemandRLT)
  Items.CurrentFR = int(Items.FR, 0, Items.SatisfiedDemand)

  where date >= oend - 365 and date <= oend
    Items.LastYearSales = sum(Orders.LokadNetAmount)
    lastYearOverallSales = sum(Orders.LokadNetAmount)
    Items.SalesWeight = Items.LastYearSales / lastYearOverallSales
    overAllCurrentFR = sum(Items.CurrentFR * Items.SalesWeight)

    Items.CategoryLastYearSales = sum(Orders.LokadNetAmount) by Items.Category at Items.Category
    Items.CategorySalesWeight = Items.LastYearSales / Items.CategoryLastYearSales
    Items.CategoryCurrentFR = sum(Items.CurrentFR * Items.CategorySalesWeight) by Items.Category

    Items.SupplierLastYearSales = sum(Orders.LokadNetAmount) by Items.Supplier at Items.Supplier
    Items.SupplierSalesWeight = Items.LastYearSales / Items.SupplierLastYearSales


  Grid.FillRateDelta = int(Items.FR, Items.SatisfiedDemand + Grid.Min, Items.SatisfiedDemand + Grid.Max)

  ///Score
  Items.RwdM = Items.SellThrough * Items.M
  Items.RwdS = - Items.SellThrough * Items.S
  Items.RwdC = Items.HoldingTime * Items.C

  Items.Reward = Items.RwdM + Items.RwdS - Items.RwdC

  Grid.M = int(Items.RwdM, Grid.Min, Grid.Max)
  Grid.S = int(Items.RwdS, Grid.Min, Grid.Max)
  Grid.C = int(Items.RwdC, Grid.Min, Grid.Max)
  Grid.Reward = int(Items.Reward, Grid.Min, Grid.Max)

  Grid.Cost = Grid.Q * Items.BuyPrice

  Grid.Score = Grid.Reward /. Grid.Cost

  ///Micro decisions build
  //removing unecessary scenario ([0,0] segment created by default in the grid)
  where Grid.Min > 0
  //Ranking potential purchases accoring to the score
    Grid.Rank = rank(Grid.Score, Id, -Grid.Max)

    Grid.Invest = sum(Grid.Cost) scan Grid.Rank
    Grid.CumFillrateDelta = sum(Grid.FillRateDelta) by Items.Id scan Grid.Rank

    Grid.OverallFRGain = Grid.FillRateDelta * Items.SalesWeight
    Grid.CumOverallFRGain = sum(Grid.OverallFRGain) scan Grid.Rank

    Grid.CategoryFRGain = Grid.FillRateDelta * Items.CategorySalesWeight
    Grid.CumCategoryFRGain = sum(Grid.CategoryFRGain) by Items.Category scan Grid.Rank

    ///Purchase decision
    //Current overall FR should be 85%
    //3 categories agressiveness factors = 1-1-1 --> 87% overall fill rate
    //3 categories agressiveness factors = 3-4-5 --> 92% overall fill rate
    //3 categories agressiveness factors = 5-5-5 --> 99% overall fill rate

    Items.CategoryFRTarget = (86 + Items.AgressivenessFactor * 12) / 100

    Grid.IsEligible = FRTarget - overAllCurrentFR > 0 and
                    Grid.CumOverallFRGain <= FRTarget - overAllCurrentFR and
                    Grid.Invest < budgetTarget

    // Grid.IsEligible = Items.CategoryFRTarget - Items.CategoryCurrentFR > 0 and
    //                   Grid.CumCategoryFRGain <= Items.CategoryFRTarget - Items.CategoryCurrentFR
    // Grid.IsEligible = Grid.Score > 0

    where Grid.IsEligible
      Items.OrderQuantity = sum(Grid.Q)
      Items.ExpectedROI = sum(Grid.Reward) / sum(Grid.Cost)

    //Make sure every eligible unit has a positive reward
    Grid.NewScore = Grid.Score
    Grid.ScoreGapToZero = if Grid.Score < 0 then abs(Grid.Score) else 0
    where Grid.IsEligible
      maxEligibleRank = max(Grid.Rank)
      Grid.NewScore = Grid.Score + Grid.ScoreGapToZero + (maxEligibleRank - Grid.Rank + 1) / (maxEligibleRank * 100)
    //Remark: new rank may be different from original rank as units with higher ranks may not be available because in a different category
    Grid.NewRank = rank(Grid.NewScore, Id, -Grid.Max)

    Grid.NewReward = Grid.NewScore * Grid.Cost
    Grid.RewardDiff = Grid.NewReward - Grid.Reward
    Grid.NewS = Grid.S + Grid.RewardDiff

    //Displaying full prioritized list
    show table "All micro decisions" e25h25 write:"Clean/PurchaseResults/MicroDecisions.ion" {tileTab: "CategoryView"} with
      Grid.Rank as "Rank"
      Grid.NewRank
      Id as "SKU"
      Items.Name
      Items.Category
      Items.Supplier
      Items.BuyPrice
      Items.SellPrice
      Items.M as "Margin"
      Items.ExpectedROI
      Items.StockOnHand
      Items.StockOnOrder
      Items.LotMultiplier
      Grid.Q
      Grid.Min
      Grid.Max
      Items.SupplierLTWeeks as "SLT" {unit: "timesteps"}
      Items.ReorderCycleWeeks as "RLT" {unit: "timesteps"}
      Items.SalesWeight
      Items.CurrentFR
      Grid.FillRateDelta
      Grid.CumFillrateDelta
      Grid.OverallFRGain
      Grid.CumOverallFRGain

      Grid.CumCategoryFRGain
      Items.CategoryFRTarget
      Items.CategoryCurrentFR

      Grid.M
      Grid.NewS as "S"
      Grid.C
      Grid.NewReward as "Reward"
      Grid.NewScore as "Score"

      Grid.Cost as "Investment" {unit: #(DcUnit)}
      Grid.Invest as "CumInvest" {unit: #(DcUnit)}
      Grid.IsEligible
      order by Grid.Rank

    write Items as "Clean/PurchaseResults/DemandDistributions.ion" with
      Id = Items.Id
      AvgDemandOnRLT = Items.AvgDemandOnRLT
      SatisfiableDemand = Items.SatisfiableDemand
      SatisfiedDemand = Items.SatisfiedDemand
      TotalDemandRLT = Items.TotalDemandRLT
      TotalDemandRLTDisplay = Items.TotalDemandRLTDisplay
      HoldingTime = Items.HoldingTime

  ///Final purchase reporting
  Items.NewFR = min(int(Items.FR, 0, Items.SatisfiedDemand + Items.OrderQuantity), max(Items.CurrentFR,0.999))

Items.InvestmentRequired = Items.OrderQuantity * Items.BuyPrice


///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///--------------------------------FUTURE REORDER RECOMMENDATIONS-----------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///PO arrival---------------------------------------------------------------------------------------
WeeklyFC.POarrivalQty = sum(PO.Quantity)
                        by [Id, monday(PO.DeliveryDate)]
                        at [Id, WeeklyFC.date]

///First reorder arrival----------------------------------------------------------------------------
WeeklyFC.FirstReorderQty = same(Items.OrderQuantity)
                            by [Id, Items.SupplierLTWeeks]
                            at [Id, WeeklyFC.FutureWeekRank]

///Stock end week-----------------------------------------------------------------------------------
//We simulate the ideal stock, i.e. the stock which perfectly compensates the demand.
//To do so, we calculate the demand on a reorder cycle (except for the first reorder cycle) and
//we offset it to make it arrive one SLT after

WeeklyFC.ReplicateDemand = quantile(WeeklyFC.CumDemand, Items.NewFR) - quantile(WeeklyFC.PreviousCumDemand, Items.NewFR)
//WeeklyFC.Baseline//quantile(WeeklyFC.Demand, Items.NewFR)

///Demand on next reorder cycle
ItemsWeek.ReplicateDemand = same(WeeklyFC.ReplicateDemand)
                              by [WeeklyFC.Id, WeeklyFC.date]
                              at [Items.Id, Week.monday]
ItemsWeek.ReplicateDemandNextReorder = sum(ItemsWeek.ReplicateDemand) by ItemsWeek.Id over week = [0 .. Items.ReorderCycleWeeks - 1]
WeeklyFC.ReplicateDemandNextReorder = if max(WeeklyFC.FutureWeekRank - Items.TotalLTWeeks,0) mod Items.ReorderCycleWeeks == 0 and
                                       WeeklyFC.FutureWeekRank - Items.TotalLTWeeks >= 0 then same(ItemsWeek.ReplicateDemandNextReorder)
                                      by [Items.Id, Week.monday]
                                      at [WeeklyFC.Id, WeeklyFC.date]\
else 0

///Stock end week function
def process StockEndWeek(
    demand:number, /// demand quantity in selected time interval
    startStockOnHand: number,
    arrivalQty: number,
    forecastNextReorder : number,
    timeIndex : number,
    isLastPastWeek : boolean) with /// Define if the stocklevel can fall below 0 (= BackOrders)
  keep StockOnHand = 0

  if timeIndex == 0
    StockOnHand = 0
  if isLastPastWeek
    StockOnHand = startStockOnHand
  if timeIndex >= 1
    StockOnHand = max(max(StockOnHand + arrivalQty - demand,0), forecastNextReorder)

  return (StockOnHand)

///Stock end week function call
//Hypotheses:
//Stock evo function gives the stock at the end of a week
//POs arrives at the beginning of a week
//WeeklyFC.FutureWeekRank = 0 is the first week

//Initialization
where WeeklyFC.IsLastPastWeek
  Items.LastStockOnHand = same(WeeklyFC.WkStockOnHand)
  Items.LastPOArrivalQty = same(WeeklyFC.POarrivalQty)
  // Items.LastForecast = same(WeeklyFC.ReplicateDemand) //there is no forecast in last past week, so this should always be 0. Replaced by last demand
  Items.LastDemand = same(WeeklyFC.DemandQty)
  Items.LastStockEndWeek = max(Items.LastStockOnHand + Items.LastPOArrivalQty - Items.LastDemand, 0)

//Call
WeeklyFC.StockEndWeek = StockEndWeek(WeeklyFC.ReplicateDemand,
                                    Items.LastStockEndWeek,
                                    WeeklyFC.POarrivalQty + WeeklyFC.FirstReorderQty,
                                    WeeklyFC.ReplicateDemandNextReorder,
                                    WeeklyFC.FutureWeekRank,
                                    WeeklyFC.IsLastPastWeek)
                        by WeeklyFC.Id
                        scan WeeklyFC.date

///Stock start week
WeeklyFC.StockStartWeek = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.StockEndWeek)
                              when(WeeklyFC.FutureWeekRank != 0)
                              by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                              at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek else 0

///Future reorders arrival quantities---------------------------------------------------------------
WeeklyFC.FutureReordersQty = if (WeeklyFC.FutureWeekRank - Items.SupplierLTWeeks) >= 0 and//Before SLT
                              (WeeklyFC.FutureWeekRank - Items.SupplierLTWeeks) mod Items.ReorderCycleWeeks == 0 then//Every multiple of a reorder cycle
                                max(WeeklyFC.StockEndWeek
                                - WeeklyFC.StockStartWeek
                                - WeeklyFC.POarrivalQty
                                + WeeklyFC.ReplicateDemand, 0) else 0

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///------------------------------STOCK EVOLUTION WITH FUTURE REORDERS-------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Stock end week-----------------------------------------------------------------------------------

//Initialization
where WeeklyFC.IsLastPastWeek
  Items.LastStockOnHand = same(WeeklyFC.WkStockOnHand)
  Items.LastPOArrivalQty = same(WeeklyFC.POarrivalQty)
  // Items.LastForecast = same(WeeklyFC.ReplicateDemand) //there is no forecast in last past week, so this should always be 0. Replaced by last demand
  Items.LastDemand = same(WeeklyFC.DemandQty)
  Items.LastStockEndWeek = max(Items.LastStockOnHand + Items.LastPOArrivalQty - Items.LastDemand, 0)

lowBarQuantile1 = 0.1
lowBarQuantile1Display = round(lowBarQuantile1 * 100)
lowBarQuantile2 = 0.3
lowBarQuantile2Display = round(lowBarQuantile2 * 100)
highBarQuantile1 = 0.7
highBarQuantile1Display = round(highBarQuantile1 * 100)
highBarQuantile2 = 0.9
highBarQuantile2Display = round(highBarQuantile2 * 100)

WeeklyFC.AvgStockEndWeek = StockEndWeek(mean(WeeklyFC.CumDemand) - mean(WeeklyFC.PreviousCumDemand),
                                        Items.LastStockEndWeek,
                                        WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty,
                                        0,
                                        WeeklyFC.FutureWeekRank,
                                        WeeklyFC.IsLastPastWeek)
                                        by WeeklyFC.Id
                                        scan WeeklyFC.date

WeeklyFC.StockEndWeekLowBar1 = StockEndWeek(quantile(WeeklyFC.CumDemand, lowBarQuantile1) - quantile(WeeklyFC.PreviousCumDemand, lowBarQuantile1),
                                            Items.LastStockEndWeek,
                                            WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty,
                                            0,
                                            WeeklyFC.FutureWeekRank,
                                            WeeklyFC.IsLastPastWeek)
                                            by WeeklyFC.Id
                                            scan WeeklyFC.date

WeeklyFC.StockEndWeekLowBar2 = StockEndWeek(quantile(WeeklyFC.CumDemand, lowBarQuantile2) - quantile(WeeklyFC.PreviousCumDemand, lowBarQuantile2),
                                            Items.LastStockEndWeek,
                                            WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty,
                                            0,
                                            WeeklyFC.FutureWeekRank,
                                            WeeklyFC.IsLastPastWeek)
                                            by WeeklyFC.Id
                                            scan WeeklyFC.date

WeeklyFC.StockEndWeekHighBar1 = StockEndWeek(quantile(WeeklyFC.CumDemand, highBarQuantile1) - quantile(WeeklyFC.PreviousCumDemand, highBarQuantile1),
                                              Items.LastStockEndWeek,
                                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty,
                                              0,
                                              WeeklyFC.FutureWeekRank,
                                              WeeklyFC.IsLastPastWeek)
                                              by WeeklyFC.Id
                                              scan WeeklyFC.date

WeeklyFC.StockEndWeekHighBar2 = StockEndWeek(quantile(WeeklyFC.CumDemand, highBarQuantile2) - quantile(WeeklyFC.PreviousCumDemand, highBarQuantile2),
                                              Items.LastStockEndWeek,
                                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty,
                                              0,
                                              WeeklyFC.FutureWeekRank,
                                              WeeklyFC.IsLastPastWeek)
                                              by WeeklyFC.Id
                                              scan WeeklyFC.date

///Stock start week---------------------------------------------------------------------------------
WeeklyFC.AvgStockStartWeek = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.AvgStockEndWeek)
                              when(WeeklyFC.FutureWeekRank != 0)
                              by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                              at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek +
                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty else WeeklyFC.WkStockOnHand
WeeklyFC.StockStartWeekLowBar1 = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.StockEndWeekLowBar1)
                                  when(WeeklyFC.FutureWeekRank != 0)
                                  by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                                  at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek +
                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty else WeeklyFC.WkStockOnHand
WeeklyFC.StockStartWeekLowBar2 = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.StockEndWeekLowBar2)
                                  when(WeeklyFC.FutureWeekRank != 0)
                                  by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                                  at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek +
                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty else WeeklyFC.WkStockOnHand
WeeklyFC.StockStartWeekHighBar1 = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.StockEndWeekHighBar1)
                                  when(WeeklyFC.FutureWeekRank != 0)
                                  by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                                  at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek +
                              WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty else WeeklyFC.WkStockOnHand
WeeklyFC.StockStartWeekHighBar2 = if WeeklyFC.FutureWeekRank > 0 then same(WeeklyFC.StockEndWeekHighBar2)
                                  when(WeeklyFC.FutureWeekRank != 0)
                                  by [WeeklyFC.Id, WeeklyFC.FutureWeekRank]
                                  at [WeeklyFC.Id, WeeklyFC.FutureWeekRank - 1] default Items.LastStockEndWeek +
                                  WeeklyFC.POarrivalQty + WeeklyFC.FutureReordersQty else WeeklyFC.WkStockOnHand
WeeklyFC.MaxStockStartWeekHighBar2 = max(WeeklyFC.StockStartWeekHighBar2) by Items.Id * 1.1


///Reporting----------------------------------------------------------------------------------------

Items.COGSQty365 = sum(WeeklyFC.DemandQty) when (WeeklyFC.date > oend - 365 and WeeklyFC.date <= oend)
Items.COGSNetAmount365 = Items.COGSQty365 * Items.BuyPrice

Items.StockQtyBeforeReorder = sum(WeeklyFC.StockStartWeek) when(WeeklyFC.IsBeforeReorderCycle) +
                              sum(WeeklyFC.POarrivalQty) when(WeeklyFC.IsBeforeReorderCycle)
Items.StockQtyBeforeReorderValue = Items.StockQtyBeforeReorder * Items.BuyPrice

WeeklyFC.ProjectedQtyStro1 = 1
WeeklyFC.ProjectedQtyWeak1 = 1

where WeeklyFC.date >= date(2020, 11, 01)
where Items.Id == "DS-124-EDB"
  show table "T test" b40 with
    WeeklyFC.Id as "id"

    WeeklyFC.date as "Mday"
    WeeklyFC.IsLastPastWeek
    WeeklyFC.IsBeforeReorderCycle

    WeeklyFC.FutureReordersQty

    WeeklyFC.ReplicateDemand as "Forecast"
    WeeklyFC.ReplicateDemandNextReorder
    WeeklyFC.StockEndWeek

    WeeklyFC.WkStockOnHand
    WeeklyFC.StockStartWeek
    WeeklyFC.POarrivalQty
    WeeklyFC.FirstReorderQty
    Items.StockOnHand
    Items.LastStockOnHand
    Items.LastStockEndWeek
    order by WeeklyFC.Id

///Export-------------------------------------------------------------------------------------------

show table "Start Week Stock Evolution" b28 write:"Clean/PurchaseResults/StockSimulation.ion" {tileTab: "CategoryView"} with
  WeeklyFC.Id as "Sku"
  WeeklyFC.date as "Date"
  lowBarQuantile1Display
  lowBarQuantile2Display
  highBarQuantile1Display
  highBarQuantile2Display

  same(WeeklyFC.StockEndWeekLowBar1) as "StockEndWeekLowBar1"
  same(WeeklyFC.StockEndWeekLowBar2) as "StockEndWeekLowBar2"
  same(WeeklyFC.AvgStockEndWeek) as "AvgStockEndWeek"
  same(WeeklyFC.StockEndWeekHighBar1) as "StockEndWeekHighBar1"
  same(WeeklyFC.StockEndWeekHighBar2) as "StockEndWeekHighBar2"

  same(WeeklyFC.StockStartWeekLowBar1) as "StockStartWeekLowBar1"
  same(WeeklyFC.StockStartWeekLowBar2) as "StockStartWeekLowBar2"
  same(WeeklyFC.AvgStockStartWeek) as "AvgStockStartWeek"
  same(WeeklyFC.StockStartWeekHighBar1) as "StockStartWeekHighBar1"
  same(WeeklyFC.StockStartWeekHighBar2) as "StockStartWeekHighBar2"

  same(Items.StockQtyBeforeReorder into WeeklyFC) as "StockQtyBeforeReorder"
  group by WeeklyFC.Id, WeeklyFC.date
  order by WeeklyFC.Id, WeeklyFC.date desc

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------OVERALL LEVEL-------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

keep where date <= oend + lookforwardDays
keep where date >= oend - lookbackDays

show scalar "Total Investments" a4             {textAlign: center ; tileTab: "OverallView" ; textBold: "true"} with
  sum(Items.InvestmentRequired) as "" {numbers: simple ; unit: #(DcUnit)}

show scalar "Current Fill Rate on WOO" a5             {textAlign: center ; tileTab: "OverallView" ; textBold: "true"} with
  sum(Items.CurrentFR * Items.SalesWeight) as "" {numbers: percent}

show scalar "Achieved Fill Rate on WOO" a6             {textAlign: center ; tileTab: "OverallView" ; textBold: "true"} with
  sum(Items.NewFR * Items.SalesWeight) as "" {numbers: percent}

show table "Categories" b4h6        {tileTab: "OverallView" ; textBold: "true"} with
  Items.Category {value { textColor: "#000" }}
  same(Items.CategoryTurnoverL365) as "Turnover L365 d" {unit: #(DcUnit)}
  (sum(Items.COGSNetAmount365) / 365) * avg(Items.ReorderCycleWeeks) as "Avg COGs on WOO" {unit: #(DcUnit)}
  sum(Items.StockQtyBeforeReorderValue) as "Stock End SLT" {unit: #(DcUnit)}
  sum(Items.InvestmentRequired) as "Investment required" {unit: #(DcUnit)}
  group by Items.Category
  order by same(Items.CategoryTurnoverL365) desc

show linechart "Stock evolution (net amount)" a7h10        {tileTab: "OverallView"} with
  1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden ; unit: #(DcUnit)}

  sum(WeeklyFC.StockStartWeekLowBar1) as "OnHand Q\{lowBarQuantile1Display}" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
  sum(WeeklyFC.StockStartWeekLowBar2) as "OnHand Q\{lowBarQuantile2Display}" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
  sum(WeeklyFC.AvgStockStartWeek) as "OnHand Avg" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
  sum(WeeklyFC.StockStartWeekHighBar1) as "OnHand Q\{highBarQuantile1Display}" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
  sum(WeeklyFC.StockStartWeekHighBar2) as "OnHand Q\{highBarQuantile2Display}" {seriesType: area ; color: #ffffff ; unit: #(DcUnit)}

  sum(WeeklyFC.AvgStockStartWeek) as "OnHand Avg" {color: #c62a2a ; seriesLegend: hidden ; unit: #(DcUnit)}
  group by WeeklyFC.date

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------CATEGORY LEVEL------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

Slices.CategoryLabel = concat(Slices.Category, " Overview")
show summary Slices.CategoryLabel  a4c5  slices: Items.slice {tileTab: "CategoryView" ; tileColor: #(highlightColor)} with
  same(Items.CategoryTurnoverL365) as "Turnover L365 d" {numbers: simple ; textBold: "true" ; unit: #(DcUnit)}
  (sum(Items.COGSNetAmount365) / 365) * avg(Items.ReorderCycleWeeks) as "Avg COGs on WOO" {numbers: simple ; textBold: "true" ; unit: #(DcUnit)}
  sum(Items.StockQtyBeforeReorderValue) as "Stock End SLT" {numbers: simple ; textBold: "true" ; unit: #(DcUnit)}
