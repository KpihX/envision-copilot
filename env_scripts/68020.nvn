  show summary "Investment decision" c21c23 slices: Items.slice {tileTab: "ItemView" ; tileColor: #(highlightColor)} with
    same(Items.OrderQuantity) as "Investment" {numbers: simple ; unit: #(pcsUnit)}
    same(Items.InvestmentRequired) as "Investment ($)" {numbers: simple ; unit: #(DcUnit)}
    same(Items.CurrentFR) as "Current FR" {numbers: percent}
    same(Items.NewFR) as "New FR" {numbers: percent}
  show linechart "Start Week Stock Evolution" d21h23  slices: Items.slice {tileTab: "ItemView"} with
    1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden ; unit: #(pcsUnit)}

    sum(WeeklyFC.StockStartWeekLowBar1) as "OnHand Q\{lowBarQuantile1Display}" {seriesType: area ; color: #fbc367 ; unit: #(pcsUnit)}
    sum(WeeklyFC.StockStartWeekLowBar2) as "OnHand Q\{lowBarQuantile2Display}" {seriesType: area ; color: #fb8f62 ; unit: #(pcsUnit)}
    sum(WeeklyFC.AvgStockStartWeek) as "OnHand Avg" {seriesType: area ; color: #fb8f62 ; unit: #(pcsUnit)}
    sum(WeeklyFC.StockStartWeekHighBar1) as "OnHand Q\{highBarQuantile1Display}" {seriesType: area ; color: #fbc367 ; unit: #(pcsUnit)}
    sum(WeeklyFC.StockStartWeekHighBar2) as "OnHand Q\{highBarQuantile2Display}" {seriesType: area ; color: #ffffff ; unit: #(pcsUnit)}

    sum(WeeklyFC.AvgStockStartWeek) as "OnHand Avg" {color: #c62a2a ; seriesLegend: hidden ; unit: #(pcsUnit)}
    group by WeeklyFC.date

show label "" a24h24 9b9b9b       {tileTab: "ItemView"}
