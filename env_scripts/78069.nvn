/// Input:  /Clean/
// Cloned from '/4. Optimization workflow/03 Forecasting' on 2024-02-26

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// --------------------------------------READ INPUT TABLES-----------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
import "/1. utilities/Modules/Global Parameters" as GP with
  DcUnit
  ColorB
  ColorLightBg
  LinkLocationItemInspector

const testStorage = ""
const inputPath = "\{testStorage}/Clean/"
const exportFile = "/Clean/validation/"
read "\{inputPath}Items.ion" as Items[Id unsafe] with
  IsTopItem : boolean
  "Sku" as Id : text
  Name : text
  Category : text
  SellPrice : number
  ImageUrl : text
  ImagePath : text
  StartDate : date
  EndDate : date
  IsClean : boolean
  LeadTime : number
  ReorderCycle : number

read "\{inputPath}Items.ion" as MySettings with
  "Category" as Category : text

read "/Manual/TopItemsParameters.xlsx" as TopItemsParameters expect[Id] with
  CategoryDisplayRank : number
  Category : text
  ItemDisplayRank : number
  Ref : text
  "Sku" as Id : text

read "\{inputPath}Forecast/Periodic/WeeklyFc.ion" as WeeklyFc expect[Id, date] with
  "Sku" as Id : text
  "Monday" as date: date
  DemandQty : number
  Cache : number
  IsPast : boolean
  FutureWeekRank : number
  IsSLT : boolean
  IsWOO : boolean
  Baseline : number
  Demand : ranvar
  LowerBarTotal2 : number
  LowerBarTotal1 : number
  HighBarTotal2 : number
  HighBarTotal1 : number
  WOODemand : ranvar

read "\{inputPath}Forecast/Periodic/FcItems.ion" as FcItems expect[Id] with
  Id : text
  GapToTarget : number
  CategoryGapToTarget : number
  overallGapToTarget : number
  ForecastSanityLabel : text
  CategoryForecastSanityLabel : text
  overallForecastSanityLabel : text
  sanityQTarget : number
  quantileLow1 : number
  quantileLow2 : number
  quantileHigh1 : number
  quantileHigh2 : number


read upload "editabletable" as editable expect[Id] with
  "Sku" as Id: text
  "Week N+1" as Week0 : number
  "Week N+2" as Week1 : number
  "Week N+3" as Week2 : number
  "Week N+4" as Week3 : number
  "Week N+5" as Week4 : number
  "Week N+6" as Week5 : number
  "Week N+7" as Week6 : number
  "Week N+8" as Week7 : number
  "Week N+9" as Week8 : number
  "Week N+10" as Week9 : number

read "\{exportFile}TestEditable.ion" as EditableCheck expect[Id] with
  "Sku" as Id : text
  Snapshot : date
  "Week N+1" as Week0 : number
  "Week N+2" as Week1 : number
  "Week N+3" as Week2 : number
  "Week N+4" as Week3 : number
  "Week N+5" as Week4 : number
  "Week N+6" as Week5 : number
  "Week N+7" as Week6 : number
  "Week N+8" as Week7 : number
  "Week N+9" as Week8 : number
  "Week N+10" as Week9 : number

read "\{exportFile}ManualForecasts.ion" as ManualForecasts expect[Id, date] with
  Id : text
  date: date
  ManualOverride : number



///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
/// ------------------------------------------SETUP-------------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Colors-------------------------------------------------------------------------------------------

highlightColor = ColorB
bgLight = ColorLightBg

// Fix Colors:
passiveColor = "#919191"

///Global parameters--------------------------------------------------------------------------------
show tabs "" a3h3 with
  "OverallView" as "Vue générale"
  "CategoryView" as "Vue par Categorie"
  "ItemView" as "Vue Article"

pcsUnit = " Pcs"
magnifierIcon = "🔎"

///Editable body------------------------------------------------------------------------------------

show logo "" a1
show label "Validation du Forecast " b1c1 {labelBorder: "none"}

show markdown "Documentation" b2h2                                  with
  """
  __Cet écran presente un éventail de differents scenarios futurs possibles. It provides the opportunity to understand and to fine-tune the Lokad forecasting output.__
  """

show label "" a2h2 9b9b9b



show label "Suivant" h1                 {href: "https://go.lokad.com/d/68020" ; hrefAspect: white ; textAlign: center}
show label "Précédent" g1                 {href: "https://go.lokad.com/d/68018" ; hrefAspect: white ; textAlign: center}
show label "Analyse détaillée du forecast" a6b6 {href: "https://go.lokad.com/d/68002/" ; hrefAspect: white ; textAlign: center;tileTab: "OverallView"}

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------PREPROCESS----------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Global parameters--------------------------------------------------------------------------------

oend = max(WeeklyFc.date) when(WeeklyFc.IsPast)
now = oend

lookbackDays = 365 + 2 * 30.5
lookforwardDays = min(max(WeeklyFc.date) - oend, 52 * 7)

keep where date <= oend + lookforwardDays

///Links to inspectors

keep where Items.IsClean

inspectorId = LinkLocationItemInspector
selectedTab = concat("&t=", "Info")
Items.hRefUrlRaw = sliceSearchUrl(inspectorId, Items.Id)
Items.hRefUrl = concat(Items.hRefUrlRaw, selectedTab)

Items.Url = replace(Items.hRefUrl , "~" , "https://go.lokad.com" )

///Life cycle
Items.LifeCycleLabel = if Items.StartDate > now - 365 then "New" else
      if Items.EndDate <= now + 365 then "Discontinued" else "Unchanged"

///Forecast-----------------------------------------------------------------------------------------


//Dispersion at overall level
quantileLow1 = same(FcItems.quantileLow1)
quantileLow2 = same(FcItems.quantileLow2)
quantileHigh1 = same(FcItems.quantileHigh1)
quantileHigh2 = same(FcItems.quantileHigh2)

///Forecast sanity

//Forecast sanity label
overallForecastSanityLabel = same(FcItems.overallForecastSanityLabel)

//Forecast confidence index
low = "🟢⚫⚫⚫⚫"
medium = "🟢🟢🟢⚫⚫"
high = "🟢🟢🟢🟢🟢"

highThreshold = 0.05
mediumThreshold = 0.08



overallGapToTarget = same(FcItems.overallGapToTarget)
overallForecastConfidenceIndex = if abs(overallGapToTarget) < highThreshold then high else
      if abs(overallGapToTarget) < mediumThreshold then medium else low

///Economic kpis------------------------------------------------------------------------------------

///Item level
Items.SalesL365 = sum(WeeklyFc.DemandQty) when (WeeklyFc.date > oend - 365)
Items.TurnoverL365 = sum(WeeklyFc.DemandQty * Items.SellPrice) when (WeeklyFc.date > oend - 365)



///Category level
Items.CategoryTurnoverL365 = sum(Items.TurnoverL365) by Items.Category

///Overall level
totalTurnoverL365 = sum(Items.TurnoverL365)

///Slices-------------------------------------------------------------------------------------------

Items.CategoryDisplayRank = same(TopItemsParameters.CategoryDisplayRank)
                            by TopItemsParameters.Category
                            at Items.Category

Items.ItemDisplayRank = same(TopItemsParameters.ItemDisplayRank)

Items.PageName = Items.Category
Items.PagePosition = Items.ItemDisplayRank
where Items.ItemDisplayRank > 0
  Items.PagePosition = rankrev () by Items.PageName scan -Items.ItemDisplayRank

table Slices [slice] = slice by [Items.CategoryDisplayRank, Items.PageName] title: Items.PageName
Slices.PageName = same(Items.PageName)
Slices.Category = same(Items.Category)


/// -------------------------------------- [ IMPLEMENT FORM ] --------------------------------------

/// UNIFY DEMAND SIZES:
WeeklyFc.OverallWeeklyDemand = sum(WeeklyFc.Demand * ceiling(Items.SellPrice)) by WeeklyFc.date
WeeklyFc.TotalDemLw3 = quantile(WeeklyFc.OverallWeeklyDemand, 0.001)
WeeklyFc.TotalDemLw2 = quantile(WeeklyFc.OverallWeeklyDemand, quantileLow2)
WeeklyFc.TotalDemLw1 = quantile(WeeklyFc.OverallWeeklyDemand, quantileLow1)
WeeklyFc.TotalDemMed = if WeeklyFc.IsPast then 0 else mean(WeeklyFc.OverallWeeklyDemand)
WeeklyFc.TotalDemUp1 = quantile(WeeklyFc.OverallWeeklyDemand, quantileHigh1)
WeeklyFc.TotalDemUp2 = quantile(WeeklyFc.OverallWeeklyDemand, quantileHigh2)
WeeklyFc.TotalDemUp3 = quantile(WeeklyFc.OverallWeeklyDemand, 0.999)

WeeklyFc.CategoryWeeklyDemand = sum(WeeklyFc.Demand * ceiling(Items.SellPrice)) by [Items.Category, WeeklyFc.date]
WeeklyFc.GrpDemLw2 = quantile(WeeklyFc.CategoryWeeklyDemand, quantileLow2)
WeeklyFc.GrpDemLw1 = quantile(WeeklyFc.CategoryWeeklyDemand, quantileLow1)
WeeklyFc.GrpDemMed = if WeeklyFc.IsPast then 0 else mean(WeeklyFc.CategoryWeeklyDemand)
WeeklyFc.GrpDemUp1 = quantile(WeeklyFc.CategoryWeeklyDemand, quantileHigh1)
WeeklyFc.GrpDemUp2 = quantile(WeeklyFc.CategoryWeeklyDemand, quantileHigh2)

WeeklyFc.DemLw2 = max(quantile(WeeklyFc.Demand, quantileLow2), 0 )
WeeklyFc.DemLw1 = max(quantile(WeeklyFc.Demand, quantileLow1), 0 )
WeeklyFc.DemMed = if not WeeklyFc.IsPast then WeeklyFc.Baseline else 0
WeeklyFc.DemUp1 = max(quantile(WeeklyFc.Demand, quantileHigh1), 0 )
WeeklyFc.DemUp2 = max(quantile(WeeklyFc.Demand, quantileHigh2), 0 )
WeeklyFc.BackgroundPeriod = if WeeklyFc.IsPast then 1 else 0

///Economic kpis------------------------------------------------------------------------------------
///Item level
Items.SalesN365 = sum(WeeklyFc.Baseline) when(WeeklyFc.date > now and WeeklyFc.date <= now + 365)
Items.TurnoverN365 = sum(WeeklyFc.Baseline * Items.SellPrice) when(WeeklyFc.date > now and WeeklyFc.date <= now + 365)
///Category level
Items.CategoryTurnoverN365 = sum(Items.TurnoverN365) by Items.Category
///Overall level

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------OVERALL LEVEL-------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
selectedTab = concat("&t=", "CategoryView")
Items.CatUrlRaw = (sliceSearchUrl(51249, Items.Category))
Items.CatUrl = concat(Items.CatUrlRaw, selectedTab)

///Overall summary
show table "Categories" c4h6              {tileTab: "OverallView" ; textBold: "true"} with
  "🔎" as "Vers Forecast" {columnReadOnly: "true" ; columnWidth: 2 ; value { textBold: "true" } ; href: #[same(Items.CatUrl)]}
  Items.Category as "Catégorie" {value { textColor: "#000" } ; href: #[same(Items.CatUrl)]}
  same(Items.CategoryTurnoverL365 / totalTurnoverL365) as "% Turnover" {numbers: percent}
  same(round(Items.CategoryTurnoverL365)) as "Turnover 365 derniers jours" {numbers: simple ; unit: #(DcUnit)}
  same(round(Items.CategoryTurnoverN365)) as "Turnover 365 prochains jours" {numbers: simple ; unit: #(DcUnit)}
  same(Items.CategoryTurnoverN365 / Items.CategoryTurnoverL365 - 1) as "Tendance globale" {numbers: percent}
  group by Items.Category
  order by same(Items.CategoryTurnoverL365) desc

///Turnover
show linechart "Prévision des ventes (montant net)" a7h10               {tileTab: "OverallView"} with
  1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden ; unit: #(DcUnit)}
  same(WeeklyFc.BackgroundPeriod) as "" {seriesType: background ; seriesOpacity: 0.3 ; color: #fadac3}
  same(WeeklyFc.TotalDemUp3) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Improbable Haut" {seriesType: area ; color: #FFE4B7 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemUp2) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Possible Haut" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemUp1) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Certain Haut" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemMed) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Moyenne attendue" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemLw1) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Certain Bas" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemLw2) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Possible Bas" {seriesType: area ; color: #FFE4B7 ; unit: #(DcUnit)}
  same(WeeklyFc.TotalDemLw3) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Improbable Bas" {seriesType: area ; color: #ffffff ; unit: #(DcUnit)}

  same(WeeklyFc.TotalDemMed) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Moyenne attendue" {color: #c62a2a ; seriesLegend: hidden ; unit: #(DcUnit)}
  group by WeeklyFc.date

///Forecast confidence
show summary "Qualité du Forecast" a4b5                                                        {tileTab: "OverallView" ; tileColor: #(highlightColor)} with
  count(Items.*) as "# Items forecastés" {unit: " Articles" ; textBold: "true"}
  overallForecastSanityLabel as "Précision forecast Q 95%" {textBold: "true"}
  overallForecastConfidenceIndex as ""

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///-----------------------------------------CATEGORY LEVEL------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

///Slices names
Slices.CategoryLabel = concat(" Vue globale ",Slices.Category)

///Reporting----------------------------------------------------------------------------------------

///Overall summary
show summary Slices.CategoryLabel  a4c5  slices:slice              {tileTab: "CategoryView" ; tileColor: #(highlightColor)} with
  same(Items.CategoryTurnoverL365 / totalTurnoverL365) as "% Turnover" {numbers: percent ; textBold: "true"}
  same(Items.CategoryTurnoverL365) as "Turnover L365 d" {numbers: simple ; textBold: "true" ; unit: #(DcUnit)}
  same(Items.CategoryTurnoverN365) as "Turnover N365 d" {numbers: simple ; textBold: "true" ; unit: #(DcUnit)}
  same(Items.CategoryTurnoverN365 / Items.CategoryTurnoverL365 - 1) as "Tendance" {numbers: percent ; textBold: "true"}
  count(Items.*) as "# Articles" {textBold: "true"}

///Turnover
WeeklyFc.slice = Items.slice
where WeeklyFc.date > monday(oend - lookbackDays)
  show linechart "Montant Net" a7h10 slices:slice              {tileTab: "CategoryView"} with
    1 as "" {seriesType: background ; color: #ffffff ; seriesLegend: hidden ; unit: #(DcUnit)}
    same(WeeklyFc.BackgroundPeriod) as "" {seriesType: background ; seriesOpacity: 0.3 ; color: #fadac3}
    same(WeeklyFc.GrpDemUp2) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Possible Haut" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
    same(WeeklyFc.GrpDemUp1) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Certain Haut" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
    same(WeeklyFc.GrpDemMed) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Moyenne Attendue" {seriesType: area ; color: #fb8f62 ; unit: #(DcUnit)}
    same(WeeklyFc.GrpDemLw1) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Certain Bas" {seriesType: area ; color: #fbc367 ; unit: #(DcUnit)}
    same(WeeklyFc.GrpDemLw2) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Possible Bas" {seriesType: area ; color: #ffffff ; unit: #(DcUnit)}

    same(WeeklyFc.GrpDemMed) + sum(WeeklyFc.DemandQty * Items.SellPrice) as "Moyenne Attendue" {color: #c62a2a ; seriesLegend: hidden ; unit: #(DcUnit)}
    group by WeeklyFc.date


  // same(Items.CategoryForecastSanityLabel) as "Accuracy in 95% interval" ///!!!!!!!
  // same(Items.CategoryForecastConfidenceIndex) as ""                     /// !!!!!!

///Leading products comparison
Items.TrendSpec = Items.TurnoverN365 / Items.TurnoverL365 - 1
Items.TrendCategory = match Items.TrendSpec with //match does not work with negative values !!!
  .. 0  -> "Negative"
  0.. 0.05  -> "[0% ; +5%]"
  0.05 .. 0.1  -> "[+5% ; +10%]"
  0.1 .. 0.15  -> "[+10% ; +15%]"
  0.15 .. 0.2  -> "[+15% ; +20%]"
  0.2 ..   -> "> +20%"

Items.TrendCategory2 = match Items.TrendSpec with //match does not work with negative values !!!
  .. 0  -> "0"
  0.. 0.05  -> "f"
  0.05 .. 0.1  -> "g"
  0.1 .. 0.15  -> "h"
  0.15 .. 0.2  -> "i"
  0.2 ..   -> "j"

where Items.TrendCategory == "Negative"
  Items.TrendCategory =  match abs(Items.TrendSpec) with
    0.. 0.05  -> "[-5% ; 0%]"
    0.05 .. 0.1  -> "[-10% ; -5%]"
    0.1 .. 0.15  -> "[-15% ; -10%]"
    0.15 .. 0.2  -> "[-20% ; -15%]"
    0.2 ..   -> "< -20%"

  Items.TrendCategory2 =  match abs(Items.TrendSpec) with
    0.. 0.05  -> "e"
    0.05 .. 0.1  -> "d"
    0.1 .. 0.15  -> "c"
    0.15 .. 0.2  -> "b"
    0.2 ..   -> "a"

Items.TrendCategoryRank = -1
where argwhichever() by Items.TrendCategory
  Items.TrendCategoryRank = rankrev () scan - Items.TrendSpec
Items.TrendCategoryRank = same(Items.TrendCategoryRank) when(Items.TrendCategoryRank != -1) by Items.TrendCategory


show barchart "Tendance du Turnover actuel" d4h6 f87551  slices:slice                                        {barchartGroups: bottom ; seriesType: stack ; tileTab: "CategoryView"}  with
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 1) as "Turnover L365 d" {color: #FF0000 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 2) as "Turnover L365 d" {color: #FF3300 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 3) as "Turnover L365 d" {color: #ff6600 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 4) as "Turnover L365 d" {color: #ff9900 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 5) as "Turnover L365 d" {color: #FFCC00 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 6) as "Turnover L365 d" {color: #FFFF00 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 7) as "Turnover L365 d" {color: #ccff00 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 8) as "Turnover L365 d" {color: #99ff00 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 9) as "Turnover L365 d" {color: #66ff00 ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) when(Items.TrendCategoryRank == 10) as "Turnover L365 d" {color: "33ff00" ; seriesLegend: hidden ; seriesOpacity: 0.75}
  sum(Items.TurnoverL365) as "Turnover L365 d" {seriesType: bar ; seriesOpacity: 0}
  group by Items.TrendCategory
  order by same(Items.TrendCategory2)

Items.CumTurnoverL365 = sum(Items.TurnoverL365) by Items.Category scan - Items.TurnoverL365
Items.BestSellerRank = rankrev () by Items.Category scan - Items.CumTurnoverL365

bestSellerDisplayNb = 40
where Items.BestSellerRank <= bestSellerDisplayNb
  show barchart "Pareto Catégorie (\{bestSellerDisplayNb} top best-sellers)" a4e7 slices:slice                          {barchartGroups: bottom ; tileTab: "ItemView"} with
    same(Items.CumTurnoverL365 / Items.CategoryTurnoverL365) as "% Ventes" {numbers: percent ; unit: " overall sales" ; seriesType: bar ; color: #fbc367}
    same(Items.CumTurnoverL365 / Items.CategoryTurnoverL365) when(Items.IsTopItem) as "Référence" {numbers: percent ; unit: " overall sales" ; seriesLegend: label ; color: #ff9500 ; seriesType: bar}
    group by Items.Id
    order by same(Items.CumTurnoverL365)

///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
///------------------------------------------ITEMS LEVEL--------------------------------------------
///~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

testItem = 0

DateWeek0 = monday(now)+ 7
DateWeek1 = monday(now)+ 2*7
DateWeek2 = monday(now)+ 3*7
DateWeek3 = monday(now)+ 4*7
DateWeek4 = monday(now)+ 5*7
DateWeek5 = monday(now)+ 6*7
DateWeek6 = monday(now)+ 7*7
DateWeek7 = monday(now)+ 8*7
DateWeek8 = monday(now)+ 9*7
DateWeek9 = monday(now)+ 10*7

EditableCheck.UnChanged0 = EditableCheck.Week0 == single(editable.Week0) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged1 = EditableCheck.Week1 == single(editable.Week1) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged2 = EditableCheck.Week2 == single(editable.Week2) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged3 = EditableCheck.Week3 == single(editable.Week3) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged4 = EditableCheck.Week4 == single(editable.Week4) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged5 = EditableCheck.Week5 == single(editable.Week5) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged6 = EditableCheck.Week6 == single(editable.Week6) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged7 = EditableCheck.Week7 == single(editable.Week7) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged8 = EditableCheck.Week8 == single(editable.Week8) by editable.Id at EditableCheck.Id
EditableCheck.UnChanged9 = EditableCheck.Week9 == single(editable.Week9) by editable.Id at EditableCheck.Id

table WeeklyFCModified = extend.range(WeeklyFc.1)


//Intergrate manual modifications that were done in previous runs. Those are accounted for in the ManualForecasts file
WeeklyFCModified.AvgDemand = single(ManualForecasts.ManualOverride) by [ManualForecasts.Id, ManualForecasts.date] at [WeeklyFCModified.Id, WeeklyFCModified.date]
//General case : if no previous modification, then input the actual forecast
WeeklyFCModified.AvgDemand = if WeeklyFCModified.AvgDemand == 0 then WeeklyFc.Baseline else WeeklyFCModified.AvgDemand
//Take into account the last batch of changes integrated through the editable
WeeklyFCModified.AvgDemand = if single(EditableCheck.UnChanged0) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else
      same(editable.Week0) by [Id, DateWeek0] at [Id, WeeklyFCModified.date] +
                              (if single(EditableCheck.UnChanged1) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week1) by [Id, DateWeek1] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged2) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week2) by [Id, DateWeek2] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged3) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week3) by [Id, DateWeek3] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged4) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week4) by [Id, DateWeek4] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged5) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week5) by [Id, DateWeek5] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged6) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week6) by [Id, DateWeek6] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged7) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week7) by [Id, DateWeek7] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged8) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week8) by [Id, DateWeek8] at [Id, WeeklyFCModified.date]) +
                              (if single(EditableCheck.UnChanged9) by EditableCheck.Id at WeeklyFCModified.Id then WeeklyFCModified.AvgDemand else same(editable.Week9) by [Id, DateWeek9] at [Id, WeeklyFCModified.date])
//Integrated the most recent batch of changes to the ManualForecasts file

Items.Week0 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek0)
Items.Week1 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek1)
Items.Week2 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek2)
Items.Week3 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek3)
Items.Week4 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek4)
Items.Week5 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek5)
Items.Week6 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek6)
Items.Week7 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek7)
Items.Week8 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek8)
Items.Week9 = single(WeeklyFCModified.AvgDemand) when(WeeklyFCModified.date == DateWeek9)

// where WeeklyFCModified.date > now
