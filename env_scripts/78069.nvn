      sum(WeeklyFc.DemMed) + sum(WeeklyFc.DemandQty) as "Moyenne attendue" {seriesType: area ; color: #fb8f62 ; unit: #(pcsUnit)}
      sum(WeeklyFc.DemLw1) + sum(WeeklyFc.DemandQty) as "Certain Bas" {seriesType: area ; color: #fbc367 ; unit: #(pcsUnit)}
      sum(WeeklyFc.DemLw2) + sum(WeeklyFc.DemandQty) as "Possible Bas" {seriesType: area ; color: #ffffff ; unit: #(pcsUnit)}

      sum(WeeklyFc.DemMed) + sum(WeeklyFc.DemandQty) as "Moyenne attendue" {color: #c62a2a ; seriesLegend: hidden ; unit: #(pcsUnit)}
      group by WeeklyFc.date

  show scalar "Demande à couvrir (Fenêtre de responsabilité)" g9h11 ae4141 slices:slice              {tileTab: "ItemView"} with same(WeeklyFc.WOODemand) {color: #ae4141}

